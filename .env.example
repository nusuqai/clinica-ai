# Copy this to .env.hosted (pointed at your real Supabase project) and/or
# .env.localdb (pointed at `npx supabase start`'s local stack).
# Scripts pick the right one explicitly via dotenv-cli — see package.json.

# Supabase (Auth / Storage / Realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Transactional + auth emails go through Resend (see docs/EMAIL.md for setup).
# If RESEND_API_KEY is unset, sending is a no-op (logged, not thrown) so local
# dev keeps working. APP_URL (below) is used to build the auth links.
RESEND_API_KEY=
# Verified sender. Before your domain verifies in Resend, you can leave this
# blank to fall back to Resend's sandbox sender (onboarding@resend.dev), which
# only delivers to your own Resend account email.
EMAIL_FROM="Nusuq <noreply@yourdomain.com>"

# Database (Prisma) — point both at the NEW Supabase project
DATABASE_URL=        # pooled connection (PgBouncer, port 6543, ?pgbouncer=true) used by the app
DIRECT_URL=          # direct connection (port 5432) used by `prisma migrate`

# AI Agent (Phase 4)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
# Chat session window in minutes (a new session starts the agent "cold"). Default 30.
SESSION_MINUTES=30


# ─── WhatsApp (Meta official Cloud API) ──────────────────────────────────────
# Every clinic runs its OWN Meta app (business not verified for a shared app
# yet). All per-clinic values — access token, phone number id, WABA id — are
# entered in the admin UI and stored in the database (WhatsappConfig), NOT here.
# Each clinic also gets a unique, unguessable callback URL + a per-clinic verify
# token (both generated and shown in the admin UI); those replace app-secret
# webhook signatures, which we can't collect while clinics use their own apps.

# Public base URL — used to build each clinic's webhook URL
# (APP_URL/api/meta/whatsapp/webhook/{token}) shown in the admin UI.
APP_URL=http://localhost:3000

# Optional — Graph API version (defaults to v23.0 if unset).
META_GRAPH_VERSION=v23.0

# Key that encrypts per-clinic WhatsApp access tokens at rest (AES-256-GCM).
# 32 random bytes as base64 or hex — generate with: openssl rand -base64 32
WHATSAPP_TOKEN_ENC_KEY=