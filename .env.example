# Copy this to one (or more) of:
#   .env.local  — local Supabase stack from `npx supabase start`  (npm run dev)
#   .env.dev    — dev-hosted Supabase project                     (npm run dev:dev)
#   .env.prod   — production Supabase project                     (npm run dev:prod)
# Scripts select the file explicitly via dotenv-cli — see package.json.

# ─── App ─────────────────────────────────────────────────────────────────────
# Root domain each clinic is served from as a subdomain (e.g. demo.$ROOT_DOMAIN);
# middleware maps it to /clinic/{slug}/… (lib/clinic-url.ts). In local dev browse
# {slug}.localhost:3000.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Public base URL — builds auth-email links and each clinic's WhatsApp webhook URL.
APP_URL=http://localhost:3000

# ─── Supabase (Auth / Storage / Realtime) ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Database (Prisma) ───────────────────────────────────────────────────────
DATABASE_URL=   # pooled (PgBouncer, port 6543, ?pgbouncer=true) — used by the app
DIRECT_URL=     # direct (port 5432) — used by `prisma migrate`

# ─── Hosting (Vercel domains) ────────────────────────────────────────────────
# Attaches each clinic's subdomain to the Vercel project (so it's served + gets
# TLS). Leave blank in local dev — subdomain registration no-ops. Token: Vercel →
# Account Settings → Tokens, scoped to the project.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=   # only if the project belongs to a team

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Auth + transactional email (docs/EMAIL.md). Unset key = sending is a no-op.
RESEND_API_KEY=
# Verified sender; blank falls back to Resend's sandbox (onboarding@resend.dev).
EMAIL_FROM="Nusuq <noreply@yourdomain.com>"
# Where internal platform alerts go — e.g. "a clinic is out of AI units".
# Comma-separated for several mailboxes. Leave blank to mail every platform
# admin's own account email instead (see lib/supabase/auth-users.ts).
PLATFORM_ALERT_EMAIL=

# ─── AI agent (OpenAI) ───────────────────────────────────────────────────────
OPENAI_API_KEY=
# Chat model (agent/model.ts). Default gpt-5.6-luna; gpt-5.6-terra is the pricier,
# smarter escalation.
OPENAI_MODEL=gpt-5.6-luna
# Reasoning effort: none|minimal|low|medium|high|xhigh. Ignored by non-reasoning
# models (gpt-4o / gpt-4.1).
OPENAI_REASONING_EFFORT=medium
# Session window in minutes; a new session starts the agent "cold".
SESSION_MINUTES=30
# Tracing (optional).
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# ─── Voice messages ──────────────────────────────────────────────────────────
# Speech-to-text for patient voice notes. Default gpt-transcribe; alternatives:
# gpt-4o-transcribe, gpt-4o-mini-transcribe, whisper-1.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Text-to-speech for spoken replies (opt-in per clinic). Output is OGG/Opus.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# Private Storage bucket for patient media — create it per environment (buckets
# are not Prisma-managed).
PATIENT_MEDIA_BUCKET=patient-media

# ─── WhatsApp (Meta Cloud API) ───────────────────────────────────────────────
# Per-clinic credentials (access token, phone number id, WABA id) are entered in
# the platform console and stored in WhatsappConfig — NOT here. Each clinic also
# gets a unique callback URL + verify token there.
# Graph API version (defaults to v23.0 if unset).
META_GRAPH_VERSION=v23.0
# Encrypts per-clinic WhatsApp tokens at rest (AES-256-GCM). 32 bytes, base64/hex
# — generate with: openssl rand -base64 32
WHATSAPP_TOKEN_ENC_KEY=

# ─── Background jobs (Inngest) ───────────────────────────────────────────────
# Appointment automation sweep + future background work. Local dev needs neither
# key (`npx inngest-cli dev`); set both only for Inngest Cloud.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
