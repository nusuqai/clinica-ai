{
  "name": "clinica-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.local -- next dev",
    "dev:dev": "dotenv -e .env.dev -- next dev",
    "dev:prod": "dotenv -e .env.prod -- next dev",
    "build": "next build",
    "build:local": "dotenv -e .env.local -- next build",
    "build:dev": "dotenv -e .env.dev -- next build",
    "build:prod": "dotenv -e .env.prod -- next build",
    "start": "next start",
    "start:local": "dotenv -e .env.local -- next start",
    "start:dev": "dotenv -e .env.dev -- next start",
    "start:prod": "dotenv -e .env.prod -- next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:validate": "dotenv -e .env.local -- prisma validate",
    "prisma:validate:dev": "dotenv -e .env.dev -- prisma validate",
    "prisma:validate:prod": "dotenv -e .env.prod -- prisma validate",
    "prisma:generate": "dotenv -e .env.local -- prisma generate",
    "prisma:generate:dev": "dotenv -e .env.dev -- prisma generate",
    "prisma:generate:prod": "dotenv -e .env.prod -- prisma generate",
    "prisma:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "prisma:migrate:dev": "dotenv -e .env.dev -- prisma migrate dev",
    "prisma:migrate:prod": "dotenv -e .env.prod -- prisma migrate dev",
    "prisma:push": "dotenv -e .env.local -- prisma db push",
    "prisma:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "prisma:deploy:dev": "dotenv -e .env.dev -- prisma migrate deploy",
    "prisma:deploy:prod": "dotenv -e .env.prod -- prisma migrate deploy",
    "prisma:studio": "dotenv -e .env.local -- prisma studio",
    "prisma:studio:dev": "dotenv -e .env.dev -- prisma studio",
    "prisma:studio:prod": "dotenv -e .env.prod -- prisma studio",
    "tunnel": "ngrok http 3000",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:reset": "npx supabase db reset",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/openai": "^1.5.3",
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.97.0",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.3",
    "gsap": "^3.14.2",
    "inngest": "^4.18.1",
    "lucide-react": "^0.575.0",
    "next": "^15.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.20.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.24",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
