generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

// Clinic-scoped roles. A user's role now lives on ClinicMember (per clinic), not
// on Profile — one account can be a PATIENT at one clinic and a DOCTOR at another.
//
// ADMIN holds every permission implicitly. STAFF is a clinic employee whose
// access comes from the custom ClinicRole it is assigned (ClinicMember.clinicRoleId)
// — see lib/permissions.ts for the permission catalog.
enum Role {
  PATIENT
  DOCTOR
  ADMIN
  STAFF
}

enum DayOfWeek {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum Channel {
  WEB
  WHATSAPP
}

enum SenderType {
  USER
  ADMIN
  AGENT
}

enum ClinicRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Movement kinds on the per-clinic AI UNIT ledger — the clinic-facing meter.
// Units are only ever granted by a platform admin (TOPUP/ADJUSTMENT) or spent
// one-per-agent-reply (USAGE). Transcription, TTS and image extraction cost the
// platform money but never cost a clinic a unit, so they have no kind here.
enum AiUnitLedgerType {
  TOPUP
  USAGE
  ADJUSTMENT
}

// Discriminates what an AiUsageLog row is billing for. A single inbound voice
// message produces a TRANSCRIPTION row (cost to understand the patient) and,
// once the agent answers, a REPLY row on the reply message; a spoken answer adds
// a TTS row. REPLY rows are token-shaped; TRANSCRIPTION/TTS rows are audio-shaped
// (see `audioSeconds`, nullable token columns). An inbound image the agent is
// allowed to read produces an EXTRACTION row (the one-time vision call that
// describes it) on the inbound message; that description is stored and reused, so
// the image is never re-read. EXTRACTION rows are token-shaped like REPLY.
enum AiUsageKind {
  REPLY
  TRANSCRIPTION
  TTS
  EXTRACTION
  // A reply of the TEAM assistant (#89) — a clinic member managing the clinic
  // from WhatsApp or the dashboard bubble. Costs one unit like REPLY; its own
  // kind so usage reports can split patient replies from staff ones.
  STAFF_REPLY
}

// Phone-number kinds shown on clinic/branch contact info.
// LANDLINE = التليفون الأرضي, MOBILE = الخط العادي/موبايل.
enum PhoneType {
  LANDLINE
  MOBILE
  WHATSAPP
}

// Doctor's professional rank shown on their profile.
// SPECIALIST = أخصائي, CONSULTANT = استشاري.
enum DoctorTitle {
  DOCTOR // طبيب/ة
  SPECIALIST
  CONSULTANT
  NURSE // ممرض/ة
  TECHNICIAN // فني/ة (ليزر، أشعة...)
  SPECIALIST_THERAPIST // أخصائي علاج / تغذية
}

// The practitioner's sex — drives gendered wording (طبيب/طبيبة، د. … هو/هي)
// since a name alone can mislead the AI agent.
enum DoctorSex {
  MALE
  FEMALE
}

// What a TreatmentProcedure row records. Kept deliberately coarse — a clinic
// types the procedure's own name in `name`; this only groups the timeline.
enum ProcedureKind {
  EXAMINATION // كشف / فحص سريري
  LAB // تحليل معملي
  IMAGING // أشعة / تصوير
  SURGERY // تدخّل جراحي
  THERAPY // جلسة علاجية
  OTHER
}

// Social-media platforms for a clinic's public accounts.
enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  X
  TIKTOK
  YOUTUBE
  WEBSITE
  OTHER
}

// Which appointment automation a ClinicAppointmentTemplate binding drives.
// CONFIRM_REMINDER = the "please confirm" message sent ~24h before the visit;
// FEEDBACK_REQUEST = the post-visit message asking the patient for feedback;
// FOLLOWUP_REMINDER = the "time to book your follow-up" message sent ahead of a
// TreatmentRecord's followUpDate, inviting the patient to book a new visit.
enum AppointmentTemplatePurpose {
  CONFIRM_REMINDER
  FEEDBACK_REQUEST
  FOLLOWUP_REMINDER
  // Operations: before a scheduled operation (leadMinutes), and a post-op
  // check-in after it is marked done (delayMinutes).
  OPERATION_REMINDER
  OPERATION_FOLLOWUP
}

// What kind of practice a clinic is. CENTER: many doctors / specialties.
// SOLO_DOCTOR: one doctor's own clinic — exactly one active doctor, and the
// landing page, AI agent and admin UI present that doctor rather than a center.
// Presentation only: the solo doctor is an ordinary Doctor row, so switching
// SOLO_DOCTOR → CENTER is just flipping this flag. Only the platform admin
// changes it. See server/services/clinic-kind.ts.
enum ClinicKind {
  CENTER
  SOLO_DOCTOR
}

// ─── Services, packages & offers (docs/services-and-packages.md) ─────────────

// Coarse type of a service — drives agent behaviour and reports. The clinic's
// own grouping is the Category.
enum ServiceKind {
  CONSULTATION // كشف
  FOLLOW_UP // استشارة / متابعة
  PROCEDURE // إجراء
  SESSION // جلسة
  TEST // تحليل / أشعة / فحص
  // عملية — never booked by a patient: the team arranges it as an Operation
  // case (see the Operations section). Always saved with bookable=false.
  OPERATION
}

enum PricingType {
  FIXED // price
  PER_UNIT // price per unitLabel × quantity
  STARTING_FROM // "from price"; final price entered at completion
  TIERED // ServicePriceTier brackets by quantity
  AFTER_CONSULTATION // no price until the visit; entered at completion
  FREE
}

// Queue (order / arrival) daily cap.
enum QueueCapType {
  NONE
  PATIENTS
  MINUTES
}

// A package credit line counts units (pulses, Botox units…) or sessions.
enum PreCheckStatus {
  PENDING
  APPROVED
  DECLINED
}

enum CreditType {
  UNITS
  SESSIONS
}

enum PatientPackageStatus {
  ACTIVE
  USED_UP
  EXPIRED
  CANCELLED
}

enum PackagePaymentStatus {
  UNPAID
  PAID
}

// PURCHASE = bought (staff sale or patient request); OFFER = free sessions
// granted by a BUY_X_GET_Y offer.
enum PatientPackageSource {
  PURCHASE
  OFFER
}

enum PackageLedgerType {
  PURCHASE // initial credit
  RESERVE // sessions held by a booking
  RELEASE // reservation returned (cancel / reschedule / line removed)
  CONSUME // used at completion (or session no-show)
  ADJUST // manual correction by staff
  EXTEND // expiry moved by staff (quantity 0)
  EXPIRE // remainder written off at expiry
  CANCEL // remainder written off when staff cancel the package
}

enum OfferType {
  PERCENT_OFF // value = percent
  AMOUNT_OFF // value = amount off
  FIXED_PRICE // value = the offer price
  BUY_X_GET_Y // services: buyQty paid → getQty free sessions (as package credit)
  BONUS_UNITS // packages: value extra units on every UNITS credit line
}

// ─── Tenancy ────────────────────────────────────────────────────────────────

// A tenant. Each clinic is isolated: its own members, doctors, appointments,
// conversations and branding. Reached at /clinic/{slug}.
model Clinic {
  id                        String                        @id @default(uuid()) @db.Uuid
  slug                      String                        @unique
  name                      String
  description               String?
  logoUrl                   String?
  primaryColor              String?
  accentColor               String?
  isActive                  Boolean                       @default(true)
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  timezone                  String                        @default("Africa/Cairo")
  // Seconds of silence after a patient's last message before the agent answers
  // the whole burst (message debounce). Per-clinic, live-editable in admin;
  // bounded 5–120 on write. See memory message-debounce-pgcron.
  debounceSeconds           Int                           @default(15)
  kind                      ClinicKind                    @default(CENTER)
  // Max services (AppointmentItem rows) per appointment. null = unlimited,
  // 1 = single-service bookings. See docs/services-and-packages.md.
  maxServicesPerAppointment Int?
  messages                  Message[]
  escalations               Escalation[]
  members                   ClinicMember[]
  roles                     ClinicRole[]
  aiAgents                  AiAgent[]
  aiAgentHours              AiAgentHours[]
  branches                  Branch[]
  phones                    ClinicPhone[]
  socials                   ClinicSocial[]
  specialties               Specialty[]
  doctors                   Doctor[]
  appointments              Appointment[]
  conversations             Conversation[]
  requestsFulfilled         ClinicRequest[]               @relation("RequestCreatedClinic")
  whatsappConfigs           WhatsappConfig[]
  whatsappHistorySyncs      WhatsappHistorySync[]
  aiCredit                  ClinicAiCredit?
  aiUsage                   AiUsageLog[]
  aiUnitLedger              AiUnitLedger[]
  branchHours               BranchHours[]
  doctorBranch              DoctorBranch[]
  availabilityRule          AvailabilityRule[]
  slot                      Slot[]
  chatSession               ChatSession[]
  branchPhone               BranchPhone[]
  dayQueues                 DoctorDayQueue[]
  appointmentTemplates      ClinicAppointmentTemplate[]
  appointmentFeedback       AppointmentFeedback[]
  knowledgeDocs             KnowledgeDoc[]
  treatmentRecords          TreatmentRecord[]
  healthSections            HealthProfileSection[]
  healthQuestions           HealthProfileQuestion[]
  healthQuestionOptions     HealthQuestionOption[]
  patientHealthProfiles     PatientHealthProfile[]
  patientHealthAnswers      PatientHealthAnswer[]
  healthAnswerRevisions     PatientHealthAnswerRevision[]
  treatmentProcedures       TreatmentProcedure[]
  prescriptions             Prescription[]
  treatmentRevisions        TreatmentRecordRevision[]
  appointmentAttachments    AppointmentAttachment[]
  conversationProcessing    ConversationProcessing[]
  conversationPins          ConversationPin[]
  inboxLabels               InboxLabel[]
  conversationReminders     ConversationReminder[]
  internalNotes             InternalNote[]
  messageNotes              MessageNote[]
  quickReplies              QuickReply[]
  staffAlerts               StaffAlert[]
  categories                Category[]
  services                  Service[]
  packages                  Package[]
  patientPackages           PatientPackage[]
  packageLedger             PackageLedger[]
  offers                    Offer[]
  appointmentItems          AppointmentItem[]
  staffAssistantSettings    StaffAssistantSettings?
  memberWhatsappLinks       MemberWhatsappLink[]
  staffEventRecipients      StaffEventRecipient[]
  staffNotifications        StaffNotification[]
  staffPendingActions       StaffPendingAction[]
  operations                Operation[]
  operationChecklistItems   OperationChecklistItem[]
  operationPayments         OperationPayment[]
  operationEvents           OperationEvent[]
  operationAttachments      OperationAttachment[]
  dataReportSettings        DataReportSettings?
  dataReportDeliveries      DataReportDelivery[]

  @@map("clinics")
}

/// Free-form clinic knowledge documents the agent can look up on demand.
/// Two tools expose these: `list_knowledge` returns the catalog (title +
/// summary per doc) so the model knows what exists, and `get_knowledge`
/// returns the full markdown `content` of one doc by `slug`. This is a
/// lightweight, tool-based alternative to vector RAG — appropriate while the
/// per-clinic document set is small. Scoped by clinic like every other table.
model KnowledgeDoc {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @db.Uuid
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  slug      String // stable handle the agent passes to get_knowledge, e.g. "company-terms"
  title     String // human title, shown in the list_knowledge catalog
  summary   String // one line describing what's inside; shown in list_knowledge
  content   String // full document as markdown; returned by get_knowledge
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, slug])
  @@index([clinicId])
  @@map("knowledge_docs")
}

// ─── Branches & contact info ──────────────────────────────────────────────────

// A physical location of a clinic. Every clinic has at least one branch
// (isMain). Doctors work at one or more branches (DoctorBranch), and each
// availability rule / slot / appointment carries the branch it belongs to.
model Branch {
  id              String   @id @default(uuid()) @db.Uuid
  clinicId        String   @db.Uuid
  name            String
  isMain          Boolean  @default(false)
  isActive        Boolean  @default(true)
  address         String?
  mapsUrl         String? // google maps link
  latitude        Decimal? @db.Decimal(10, 7)
  longitude       Decimal? @db.Decimal(10, 7)
  hasParking      Boolean  @default(false)
  parkingInfo     String?
  nearestLandmark String? // أقرب معلم
  directions      String? // كيفية الوصول
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic            Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  phones            BranchPhone[]
  hours             BranchHours[]
  doctors           DoctorBranch[]
  availabilityRules AvailabilityRule[]
  slots             Slot[]
  appointments      Appointment[]
  dayQueues         DoctorDayQueue[]
  treatmentRecords  TreatmentRecord[]
  staffMembers      ClinicMemberBranch[]
  whatsappConfigs   WhatsappConfig[]
  serviceBranches   ServiceBranch[]
  packageBranches   PackageBranch[]
  offerBranches     OfferBranch[]
  patientPackages   PatientPackage[]
  operations        Operation[]

  @@index([clinicId])
  @@map("branches")
}

// Phone specific to one branch.
model BranchPhone {
  id        String    @id @default(uuid()) @db.Uuid
  branchId  String    @db.Uuid
  clinicId  String    @db.Uuid
  type      PhoneType
  number    String
  label     String? // e.g. "استقبال", "حجز"
  isPrimary Boolean   @default(false)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([clinicId])
  @@map("branch_phones")
}

// Branch opening hours — one row per weekday. A day off is isClosed = true
// (openTime/closeTime null). Doctor availability rules must fit inside the
// branch's [openTime, closeTime] for that day.
model BranchHours {
  id        String    @id @default(uuid()) @db.Uuid
  branchId  String    @db.Uuid
  clinicId  String    @db.Uuid
  dayOfWeek DayOfWeek
  isClosed  Boolean   @default(false)
  openTime  String? // "HH:MM"
  closeTime String? // "HH:MM"

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
  @@index([clinicId])
  @@map("branch_hours")
}

// General clinic-level phone. The clinic's main number is the row with
// isPrimary = true.
model ClinicPhone {
  id        String    @id @default(uuid()) @db.Uuid
  clinicId  String    @db.Uuid
  type      PhoneType
  number    String
  label     String?
  isPrimary Boolean   @default(false)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@map("clinic_phones")
}

// A clinic's public social-media account. Clinic-level (not per-branch).
model ClinicSocial {
  id       String         @id @default(uuid()) @db.Uuid
  clinicId String         @db.Uuid
  platform SocialPlatform
  url      String

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@map("clinic_socials")
}

// Per-clinic WhatsApp Cloud API (Meta official) credentials. Entered manually
// by an admin — no embedded-signup provider yet (business not verified), and
// each clinic runs its OWN Meta app, so we can't collect app secrets to verify
// webhook signatures. Instead each clinic gets a unique, unguessable webhook
// URL: the `webhookToken` in the path both identifies the clinic and acts as
// the shared secret. The access token is encrypted at rest (AES-256-GCM, see
// lib/crypto/secret-box.ts); the other values are low-sensitivity config the
// clinic itself must copy into Meta.
//
// A clinic connects through ONE provider, picked by the platform admin:
// META_CLOUD (official Cloud API — the Meta columns below are set) or EVOLUTION
// (unofficial WhatsApp Web via a self-hosted Evolution API — only
// `evolutionInstanceName` is set).
/// One WhatsApp number of a clinic. A clinic can attach several: at most one
/// official (META_CLOUD, set up by support) plus any number of WhatsApp Web
/// (EVOLUTION) numbers it links itself. Exactly one is the clinic's main number
/// — the fallback sender when a conversation has no number of its own yet.
model WhatsappConfig {
  id                    String           @id @default(uuid()) @db.Uuid
  clinicId              String           @db.Uuid
  provider              WhatsappProvider @default(META_CLOUD)
  isPrimary             Boolean          @default(false)
  // The branch this number belongs to; null = a clinic-level number. Decides who
  // sees its messages: clinic-wide staff see every number, branch-limited staff
  // only their branches' numbers. A deleted branch's numbers become clinic-level.
  branchId              String?          @db.Uuid
  // The number's own phone (digits, with country code) once known — EVOLUTION
  // learns it when the phone links. Shown in the inbox's number picker, and
  // how re-linking the same phone is recognised and merged.
  phone                 String?
  // When the number was unlinked (WhatsApp Web logged out from the settings
  // page). Null = an active number. An unlinked number keeps its messages and
  // conversations — they stay in the inbox, labelled as an old number — but it
  // can't send, receive or be the main number. Linking the same phone again
  // (re-linking this row, or a new number that turns out to be this phone)
  // brings it back; a later history sync only adds what's missing.
  unlinkedAt            DateTime?
  // META_CLOUD: WhatsApp sender id ("Phone number ID" in the Meta dashboard).
  phoneNumberId         String?          @unique
  // META_CLOUD: WhatsApp Business Account id — needed to list/create templates.
  wabaId                String?
  // META_CLOUD: system-user access token, encrypted. Never selected into client code raw.
  accessTokenCipher     String?
  // EVOLUTION: the instance name on the Evolution server (one per clinic).
  evolutionInstanceName String?          @unique
  // Unguessable token embedded in this clinic's unique callback URL
  // (…/api/meta/whatsapp/webhook/{token} or …/api/evolution/webhook/{token}).
  // Routes inbound events to the clinic and, in lieu of signature
  // verification, gates the endpoint.
  webhookToken          String           @unique
  // META_CLOUD: the verify token this clinic types into Meta's webhook config;
  // checked on the GET verification handshake.
  verifyToken           String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  clinic      Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  branch      Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  messages    Message[]
  historySync WhatsappHistorySync?
  memberLinks MemberWhatsappLink[]

  @@index([clinicId])
  @@index([branchId])
  @@map("whatsapp_configs")
}

/// A WhatsApp-Web number's latest chat-history import (Evolution only) — one
/// row per number, overwritten by a fresh sync. Progress is saved after every
/// chat so staff can stop a sync and later resume it where it stopped.
model WhatsappHistorySync {
  id               String            @id @default(uuid()) @db.Uuid
  clinicId         String            @db.Uuid
  whatsappConfigId String            @unique @db.Uuid
  status           HistorySyncStatus
  // Identifies the background run allowed to write progress; a resume or a
  // fresh start gets a new one, so a stale run that's still winding down
  // can't overwrite the new state.
  runId            String            @db.Uuid
  // Import messages sent after this moment (start time − 90 days).
  since            DateTime
  // The chats (remote JIDs) to import, fixed when the sync first lists them;
  // null until listed.
  chats            Json?
  totalChats       Int               @default(0)
  // Chats [0, nextIndex) are fully imported.
  nextIndex        Int               @default(0)
  messagesImported Int               @default(0)
  error            String?
  startedAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  finishedAt       DateTime?

  clinic         Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  whatsappConfig WhatsappConfig @relation(fields: [whatsappConfigId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@map("whatsapp_history_syncs")
}

enum HistorySyncStatus {
  RUNNING
  STOPPED
  COMPLETED
  FAILED
}

enum WhatsappProvider {
  META_CLOUD
  EVOLUTION
}

// Membership join table: a Profile belongs to a Clinic with a role. The unique
// pair (userId, clinicId) means one role per user per clinic.
model ClinicMember {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  clinicId         String   @db.Uuid
  role             Role
  // The custom role a STAFF member holds; null for every other role (and for a
  // STAFF member whose role was removed — they then have no permissions).
  clinicRoleId     String?  @db.Uuid
  // Branch scope for STAFF (GitHub #52). true = every branch of the clinic;
  // false = only the branches listed in `branches`. Deliberately an explicit
  // flag rather than "empty list means all": deleting a member's last branch
  // must leave them with NO branch, never silently widen them to all of them.
  // Ignored for ADMIN (always all), DOCTOR and PATIENT.
  allBranches      Boolean  @default(true)
  // Team assistant (#89): whether this member may manage the clinic through the
  // AI (WhatsApp + dashboard bubble). Set by a clinic ADMIN; ignored for ADMIN
  // (always allowed) and PATIENT (never).
  assistantEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())

  user               Profile               @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic             Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicRole         ClinicRole?           @relation(fields: [clinicRoleId], references: [id], onDelete: SetNull)
  branches           ClinicMemberBranch[]
  whatsappLink       MemberWhatsappLink?
  eventSubscriptions StaffEventRecipient[]
  staffNotifications StaffNotification[]
  dataReports        DataReportDelivery[]

  @@unique([userId, clinicId])
  @@index([clinicId])
  @@index([clinicRoleId])
  @@map("clinic_members")
}

// The branches a STAFF member is limited to (when ClinicMember.allBranches is
// false). The role says WHAT they may manage; these rows say WHERE.
model ClinicMemberBranch {
  memberId String @db.Uuid
  branchId String @db.Uuid

  member ClinicMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  branch Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([memberId, branchId])
  @@index([branchId])
  @@map("clinic_member_branches")
}

// An AI employee of the clinic: a named assistant with its own persona and
// working hours, set up by the platform team (/platform/agents). While it is on
// shift it answers patient chats under its own name and style. Active agents of
// one clinic never have overlapping hours, so at most one is on shift at any
// moment; when none is (including a clinic with no agents at all), the AI stays
// silent and an escalation is raised for the human staff — see
// server/services/aiAgents.ts.
model AiAgent {
  id                          String   @id @default(uuid()) @db.Uuid
  clinicId                    String   @db.Uuid
  name                        String
  jobTitle                    String?
  // Free-form tone/style instructions. Injected into the system prompt as style
  // guidance only — it never overrides the agent's rules.
  persona                     String   @default("") @db.Text
  isActive                    Boolean  @default(true)
  // true → on shift 24/7 and `hours` is ignored.
  alwaysOn                    Boolean  @default(false)
  // Usage limits, both counted in units (1 unit = 1 reply) over a ROLLING 24
  // hours and both null = unlimited. Once a cap is reached the agent stays
  // silent and the chat is escalated to the human staff until the window frees.
  //   dailyUnitCap                — everything this agent replies, to anyone.
  //   dailyUnitCapPerConversation — what it replies to ONE conversation, so a
  //                                 single chatty patient can't drain the cap.
  dailyUnitCap                Int?
  dailyUnitCapPerConversation Int?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  clinic   Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  hours    AiAgentHours[]
  messages Message[]
  usage    AiUsageLog[]

  @@unique([clinicId, name])
  @@index([clinicId])
  @@map("ai_agents")
}

// One shift per day for an AI employee, on the clinic's wall clock (same
// "HH:MM" convention as BranchHours). endTime <= startTime means the shift
// runs past midnight into the next day. No row for a day = off that day.
model AiAgentHours {
  id        String    @id @default(uuid()) @db.Uuid
  agentId   String    @db.Uuid
  clinicId  String    @db.Uuid
  dayOfWeek DayOfWeek
  startTime String // "HH:MM"
  endTime   String // "HH:MM"

  clinic Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  agent  AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, dayOfWeek])
  @@index([clinicId])
  @@map("ai_agent_hours")
}

// A custom role a clinic ADMIN defines for its staff: a name plus the set of
// permission keys it grants. Keys are validated against lib/permissions.ts on
// write and filtered against it on read, so an unknown key is simply ignored.
model ClinicRole {
  id          String   @id @default(uuid()) @db.Uuid
  clinicId    String   @db.Uuid
  name        String
  description String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic  Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  members ClinicMember[]

  @@unique([clinicId, name])
  @@map("clinic_roles")
}

// A request (from the public landing page) to create a new clinic. The platform
// admin team reviews and approves/rejects it; on approval a Clinic is created and
// the requester is set up as that clinic's ADMIN.
model ClinicRequest {
  id                  String              @id @default(uuid()) @db.Uuid
  requesterName       String
  requesterEmail      String
  requesterPhone      String?
  requestedClinicName String
  requestedSlug       String?
  note                String?
  status              ClinicRequestStatus @default(PENDING)
  reviewedById        String?             @db.Uuid
  reviewedAt          DateTime?
  createdClinicId     String?             @db.Uuid
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  reviewedBy    Profile? @relation("RequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdClinic Clinic?  @relation("RequestCreatedClinic", fields: [createdClinicId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("clinic_requests")
}

// ─── Models ───────────────────────────────────────────────────────────────────

// Mirrors auth.users — id is provided by Supabase Auth, not generated by Prisma.
// Identity only: the per-clinic role lives on ClinicMember. isPlatformAdmin marks
// the Nusuq administration team that manages all clinics.
model Profile {
  id              String   @id @db.Uuid
  fullName        String
  phone           String?  @unique
  avatarUrl       String?
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  doctor                Doctor?
  appointments          Appointment[]
  conversations         Conversation[]
  sentMessages          Message[]                     @relation("SenderProfile")
  resolvedEscalations   Escalation[]                  @relation("EscalationResolver")
  aiToggledSessions     ChatSession[]                 @relation("SessionAiToggler")
  clinicMemberships     ClinicMember[]
  reviewedRequests      ClinicRequest[]               @relation("RequestReviewer")
  appointmentFeedback   AppointmentFeedback[]
  // Medical history: records ABOUT this profile as a patient, records it wrote
  // as a doctor, and the edits it made to any record.
  treatmentRecords      TreatmentRecord[]             @relation("PatientTreatmentRecords")
  authoredRecords       TreatmentRecord[]             @relation("AuthoredTreatmentRecords")
  treatmentEdits        TreatmentRecordRevision[]     @relation("TreatmentRecordEdits")
  // Health profile: the per-clinic files this profile has as a patient, the
  // answers it last wrote (as patient or staff) and every answer edit it made.
  healthProfiles        PatientHealthProfile[]
  updatedHealthAnswers  PatientHealthAnswer[]         @relation("HealthAnswerUpdater")
  healthAnswerEdits     PatientHealthAnswerRevision[] @relation("HealthAnswerEdits")
  // Visit files this profile uploaded as staff.
  uploadedAttachments   AppointmentAttachment[]       @relation("UploadedAttachments")
  // Inbox utilities (per-user state + team collaboration on conversations).
  assignedConversations Conversation[]                @relation("ConversationAssignee")
  assignedByMe          Conversation[]                @relation("ConversationAssigner")
  conversationPins      ConversationPin[]
  inboxLabels           InboxLabel[]
  createdReminders      ConversationReminder[]        @relation("ReminderCreator")
  doneReminders         ConversationReminder[]        @relation("ReminderCompleter")
  internalNotes         InternalNote[]
  messageNotes          MessageNote[]
  quickReplies          QuickReply[]
  receivedStaffAlerts   StaffAlert[]                  @relation("StaffAlertRecipient")
  sentStaffAlerts       StaffAlert[]                  @relation("StaffAlertActor")
  resolvedStaffAlerts   StaffAlert[]                  @relation("StaffAlertResolver")
  // Prepaid packages this profile owns as a patient.
  patientPackages       PatientPackage[]
  staffPendingActions   StaffPendingAction[]
  operations            Operation[]                   @relation("PatientOperations")
  coordinatedOperations Operation[]                   @relation("OperationCoordinator")
  operationEvents       OperationEvent[]              @relation("OperationEventActor")
  operationAttachments  OperationAttachment[]         @relation("OperationAttachmentUploader")

  @@map("profiles")
}

// Throttles how often a signup verification code can be emailed to an address.
// Keyed by email (lower-cased) rather than a user id, because the account may
// not be confirmed — or may be recreated — between requests. See the OTP resend
// cooldown in startClinicSignup / signInToClinic.
model OtpRequest {
  email      String   @id
  lastSentAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("otp_requests")
}

// A doctor is a standalone record scoped to a clinic. It can exist WITHOUT any
// login account (profileId null) and still be linked to appointments; an account
// can be linked later by setting profileId.
model Doctor {
  id                     String       @id @default(uuid()) @db.Uuid
  clinicId               String       @db.Uuid
  profileId              String?      @unique @db.Uuid
  specialtyId            String?      @db.Uuid // FK to the clinic's Specialty list
  fullName               String
  phone                  String?
  title                  DoctorTitle? // أخصائي / استشاري
  sex                    DoctorSex? // ذكر / أنثى
  qualifications         String? // المؤهلات العلمية
  expertiseAreas         String? // مجالات الخبرة الدقيقة
  bio                    String?
  yearsOfExperience      Int?
  requiresAdvanceBooking Boolean      @default(true) // يحتاج حجزاً مسبقاً؟
  acceptsChildren        Boolean      @default(false) // يكشف على الأطفال؟
  isActive               Boolean      @default(true)

  clinic            Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  profile           Profile?           @relation(fields: [profileId], references: [id], onDelete: SetNull)
  specialty         Specialty?         @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  branches          DoctorBranch[]
  availabilityRules AvailabilityRule[]
  slots             Slot[]
  appointments      Appointment[]      @relation("DoctorAppointments")
  referralsMade     Appointment[]      @relation("ReferredAppointments")
  dayQueues         DoctorDayQueue[]
  treatmentRecords  TreatmentRecord[]
  services          DoctorService[]
  appointmentItems  AppointmentItem[]
  operations        Operation[]

  @@index([clinicId])
  @@index([specialtyId])
  @@map("doctors")
}

// Per-clinic list of medical specialties. Names are unique within a clinic;
// the same name can exist across different clinics. Case-insensitive
// uniqueness is enforced at the service layer.
model Specialty {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic  Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctors Doctor[]

  @@unique([clinicId, name])
  @@index([clinicId])
  @@map("specialties")
}

// Join table: which branches a doctor works at (many-to-many).
model DoctorBranch {
  doctorId String @db.Uuid
  branchId String @db.Uuid
  clinicId String @db.Uuid

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([doctorId, branchId])
  @@index([branchId])
  @@index([clinicId])
  @@map("doctor_branches")
}

// How a doctor's availability rule schedules patients.
enum AvailabilityMode {
  SLOT_BASED // fixed time slots — patient picks a specific time
  ORDER_BASED // queue / نظام الدور — sequential order numbers handed out at booking
  ARRIVAL_BASED // أسبقية الحضور — patient reserves; the order number is handed out at check-in, by physical arrival order
  // حجز يوم فقط — the patient books the DAY only; the clinic team then contacts
  // them and sets the exact time (Appointment.scheduledTime). No slots, no order
  // numbers, no overlap checks: timing is the clinic's responsibility. Uses the
  // DoctorDayQueue row only as the day's booking ledger (optional cap).
  DAY_ONLY
}

model AvailabilityRule {
  id                   String           @id @default(uuid()) @db.Uuid
  doctorId             String           @db.Uuid
  clinicId             String           @db.Uuid
  branchId             String?          @db.Uuid // branch this schedule is for (required for new rows)
  dayOfWeek            DayOfWeek
  startTime            String // "HH:MM" e.g. "14:00" (queue session start for order-based)
  endTime              String // "HH:MM" e.g. "17:00"
  slotDurationMin      Int              @default(30) // slot-based: minutes per slot
  mode                 AvailabilityMode @default(SLOT_BASED)
  // Order-based only: estimated minutes a patient spends with the doctor (drives
  // the wait estimate) and the max bookings allowed for the day.
  estimatedDurationMin Int?
  // Queue rules: how the day is capped. NONE = unlimited; PATIENTS = dailyCap
  // bookings; MINUTES = dailyCapMinutes of booked service time.
  capType              QueueCapType     @default(PATIENTS)
  dailyCap             Int?
  dailyCapMinutes      Int?
  isActive             Boolean          @default(true)
  // When true, patients cannot book this rule's slots directly; they are
  // reserved for referrals made by a doctor after examining a patient.
  referralOnly         Boolean          @default(false)
  note                 String? // free-text admin/doctor note about this rule
  generatedUntil       DateTime?        @db.Date // slot-based: how far ahead slots have been generated

  clinic       Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor       Doctor           @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch       Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  slots        Slot[]
  queues       DoctorDayQueue[]
  appointments Appointment[]
  // Optional restriction: only these services may be booked on this rule.
  // No rows = every service the doctor provides.
  services     RuleService[]

  @@index([doctorId])
  @@index([branchId])
  @@index([clinicId])
  @@map("availability_rules")
}

// Per (doctor, branch, day) queue state for order-based scheduling. Created
// lazily on the first order-based booking of the day.
model DoctorDayQueue {
  id                   String       @id @default(uuid()) @db.Uuid
  clinicId             String       @db.Uuid
  doctorId             String       @db.Uuid
  branchId             String?      @db.Uuid
  ruleId               String?      @db.Uuid
  date                 DateTime     @db.Date
  nextOrder            Int          @default(1) // next booking counter to hand out. ORDER_BASED: also the serving order. ARRIVAL_BASED: reservation counter (caps bookings); serving order comes from nextArrival instead.
  // ARRIVAL_BASED only: next arrival/serving order to hand out at check-in.
  // Bumped when reception marks a reserved patient as arrived. Unused by ORDER_BASED.
  nextArrival          Int          @default(1)
  currentOrder         Int          @default(0) // "now serving" — 0 = not started
  // Next order to serve when the doctor clicks "next patient". Normally
  // currentOrder+1, but a recall moves currentOrder back to a returning patient
  // without touching this, so serving resumes here afterward.
  serveNextOrder       Int          @default(1)
  dailyCap             Int? // snapshot from the rule
  capType              QueueCapType @default(PATIENTS) // snapshot from the rule
  dailyCapMinutes      Int? // snapshot from the rule
  // Total service minutes booked into this day (claimed atomically like
  // nextOrder); drives the MINUTES cap and expected times.
  bookedMinutes        Int          @default(0)
  estimatedDurationMin Int? // snapshot from the rule
  trackCurrentOrder    Boolean      @default(true) // false = patients see only their own number
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  clinic       Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor       Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch       Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  rule         AvailabilityRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@unique([doctorId, branchId, date])
  @@index([clinicId])
  @@index([branchId])
  @@map("doctor_day_queues")
}

model Slot {
  id                   String   @id @default(uuid()) @db.Uuid
  doctorId             String   @db.Uuid
  clinicId             String   @db.Uuid
  branchId             String?  @db.Uuid // copied from the rule at generation time
  ruleId               String?  @db.Uuid
  date                 DateTime @db.Date
  startTime            DateTime
  endTime              DateTime
  isBlocked            Boolean  @default(false)
  clinic               Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  // Snapshot of the rule's referralOnly flag at generation time; keeps
  // patient-facing booking queries fast without joining the rule.
  referralOnly         Boolean  @default(false)
  // Occupancy: the appointment holding this slot. A long appointment holds
  // several consecutive slots (Appointment.slotId is only its first one).
  // null = free. Cleared when the appointment is cancelled or rescheduled.
  heldById             String?  @db.Uuid
  // Set when isBlocked was turned on because the doctor has an operation at
  // that time — so cancelling / moving the operation frees exactly these slots
  // and never one the doctor blocked by hand.
  blockedByOperationId String?  @db.Uuid

  appointment          Appointment?      @relation("AppointmentHeldSlots", fields: [heldById], references: [id], onDelete: SetNull)
  blockedByOperation   Operation?        @relation(fields: [blockedByOperationId], references: [id], onDelete: SetNull)
  doctor               Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch               Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  rule                 AvailabilityRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  // Appointments that START here (Appointment.slotId), incl. cancelled history.
  // Occupancy is `appointment` (heldById) above.
  startingAppointments Appointment[]

  @@index([doctorId, date])
  @@index([branchId])
  @@index([clinicId, date])
  @@index([heldById])
  @@index([blockedByOperationId])
  @@map("slots")
}

model Appointment {
  id                   String            @id @default(uuid()) @db.Uuid
  clinicId             String            @db.Uuid
  branchId             String?           @db.Uuid // copied from the slot at booking time
  patientId            String            @db.Uuid
  doctorId             String            @db.Uuid
  // Set when this appointment was created as a referral by another doctor.
  referredByDoctorId   String?           @db.Uuid
  // Slot-based bookings set slotId. Order-based bookings leave it null and set
  // ruleId + bookingDate + orderNumber + queueId instead. slotId is the FIRST
  // slot of the visit and is kept after cancellation (history); which slots are
  // actually occupied is Slot.heldById.
  slotId               String?           @db.Uuid
  ruleId               String?           @db.Uuid // which rule/mode produced this booking
  queueId              String?           @db.Uuid // order-based: the day queue this booking belongs to
  bookingDate          DateTime?         @db.Date // order-based: the day (slot-based derives from slot)
  orderNumber          Int? // order-based: queue position. ARRIVAL_BASED: null until the patient is checked in (then set to their arrival order)
  estimatedDurationMin Int? // order-based: snapshot at booking (stable wait calc)
  // ARRIVAL_BASED (أسبقية الحضور): set when reception checks the patient in at the
  // clinic. Assigning arrivedAt is what hands out orderNumber. Null = reserved but
  // not yet arrived. Always null for SLOT_BASED / ORDER_BASED bookings.
  arrivedAt            DateTime?
  // DAY_ONLY (حجز يوم فقط): the exact time the clinic team agreed with the
  // patient, as clinic wall-clock "HH:MM" on bookingDate (same convention as
  // AvailabilityRule.startTime). Null = still waiting for the team to set it.
  // Free-form: never checked for overlaps. Always null for the other modes.
  scheduledTime        String?
  status               AppointmentStatus @default(PENDING)
  // Order-based: set when the doctor temporarily skips this order (patient not
  // present). Keeps status PENDING; cleared on recall. Skipped orders are passed
  // over by the queue but not lost.
  skippedAt            DateTime?
  patientNotes         String?
  doctorNotes          String?
  cancelledAt          DateTime?
  cancellationReason   String?
  // Set when the appointment transitions to CONFIRMED / COMPLETED. Distinct from
  // updatedAt (which any edit bumps): the automation sweep needs the actual
  // moment of completion to time the feedback message ("delay after completed").
  confirmedAt          DateTime?
  completedAt          DateTime?
  // Automation dedupe flags. Non-null = that message has already been queued, so
  // the sweep never sends it twice. Left null until sent, so an appointment whose
  // clinic links a template later is still picked up on a later tick.
  reminderSentAt       DateTime?
  feedbackRequestedAt  DateTime?
  // Service totals (sum of items), snapshotted at booking / completion.
  totalDurationMin     Int?
  estimatedTotal       Decimal?          @db.Decimal(10, 2)
  finalTotal           Decimal?          @db.Decimal(10, 2)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  clinic          Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  branch          Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient         Profile                 @relation(fields: [patientId], references: [id])
  doctor          Doctor                  @relation("DoctorAppointments", fields: [doctorId], references: [id])
  referredBy      Doctor?                 @relation("ReferredAppointments", fields: [referredByDoctorId], references: [id])
  slot            Slot?                   @relation(fields: [slotId], references: [id])
  rule            AvailabilityRule?       @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  queue           DoctorDayQueue?         @relation(fields: [queueId], references: [id], onDelete: SetNull)
  feedback        AppointmentFeedback?
  // The clinical record for this visit, if the doctor wrote one.
  treatmentRecord TreatmentRecord?
  // Files (lab results, x-rays, documents) attached to this visit by staff.
  attachments     AppointmentAttachment[]
  // The services booked in this visit (>= 1).
  items           AppointmentItem[]
  // Every slot this appointment occupies (slot-based; long services span several).
  heldSlots       Slot[]                  @relation("AppointmentHeldSlots")

  @@index([clinicId])
  @@index([branchId])
  @@index([patientId])
  @@index([doctorId])
  @@index([referredByDoctorId])
  @@index([queueId])
  @@index([slotId])
  @@index([doctorId, bookingDate])
  // Sweep passes: reminder discovery (PENDING + not yet reminded),
  // feedback discovery (COMPLETED + not yet requested), and the no-show sweep
  // scanning slot-based bookings by status.
  @@index([status, reminderSentAt])
  @@index([status, feedbackRequestedAt])
  @@index([status, completedAt])
  @@map("appointments")
}

// ─── Services, packages & offers ─────────────────────────────────────────────
// Design and rules: docs/services-and-packages.md.

// The clinic's own grouping, shared by services and packages ("ليزر", "حشو"...).
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @db.Uuid
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  services     Service[]
  packages     Package[]
  packageItems PackageItem[]
  offerTargets OfferTarget[]

  @@unique([clinicId, name])
  @@index([clinicId])
  @@map("catalog_categories")
}

model Service {
  id                   String      @id @default(uuid()) @db.Uuid
  clinicId             String      @db.Uuid
  categoryId           String      @db.Uuid
  name                 String
  description          String? // public
  prepInstructions     String? // public: before/after the visit
  agentNotes           String? // AI agent only — never shown to patients
  kind                 ServiceKind
  pricingType          PricingType
  // FIXED / STARTING_FROM: the price. PER_UNIT: the unit price. Null when the
  // price only comes from doctor/branch overrides or is decided later.
  price                Decimal?    @db.Decimal(10, 2)
  unitLabel            String? // PER_UNIT / TIERED: "نبضة", "وحدة", "سن", "مل"
  durationMin          Int? // null → the rule's slot / estimated duration
  bookable             Boolean     @default(true)
  isActive             Boolean     @default(true)
  // OPERATION services only: the pre-op checklist copied into every new case of
  // this operation (labs, imaging, consent…), and the after-care text.
  // prepInstructions above is the pre-op instructions text.
  operationChecklist   String[]    @default([])
  postOpInstructions   String?
  // Pre-check: another service (e.g. a كشف) that must be done first; the
  // practitioner then approves or declines this one at the visit. Declined →
  // only the pre-check is charged. An approval stays valid for
  // preCheckValidityDays (null = a pre-check every visit). preCheckFeeDeducted
  // = when approved, the pre-check itself is not charged.
  preCheckServiceId    String?     @db.Uuid
  preCheckValidityDays Int?
  preCheckFeeDeducted  Boolean     @default(false)
  // true = offered in every branch (ServiceBranch rows only override price);
  // false = offered only in branches that have a ServiceBranch row.
  allBranches          Boolean     @default(true)
  sortOrder            Int         @default(0)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  clinic           Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  category         Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  branches         ServiceBranch[]
  tiers            ServicePriceTier[]
  doctors          DoctorService[]
  rules            RuleService[]
  packageItems     PackageItemService[]
  offerTargets     OfferTarget[]
  appointmentItems AppointmentItem[]
  operations       Operation[]
  preCheckService  Service?             @relation("ServicePreCheck", fields: [preCheckServiceId], references: [id], onDelete: SetNull)
  preCheckFor      Service[]            @relation("ServicePreCheck")

  @@unique([clinicId, name])
  @@index([clinicId])
  @@index([categoryId])
  @@map("services")
}

model ServiceBranch {
  serviceId String   @db.Uuid
  branchId  String   @db.Uuid
  price     Decimal? @db.Decimal(10, 2) // branch price override

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([serviceId, branchId])
  @@index([branchId])
  @@map("service_branches")
}

// TIERED pricing: the price for a quantity bracket (total, not per unit).
model ServicePriceTier {
  id        String  @id @default(uuid()) @db.Uuid
  serviceId String  @db.Uuid
  minQty    Int
  maxQty    Int? // null = and above
  price     Decimal @db.Decimal(10, 2)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_price_tiers")
}

// Which practitioner provides which service, with optional overrides.
model DoctorService {
  doctorId    String   @db.Uuid
  serviceId   String   @db.Uuid
  price       Decimal? @db.Decimal(10, 2)
  durationMin Int?

  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([doctorId, serviceId])
  @@index([serviceId])
  @@map("doctor_services")
}

// Optional per-rule restriction (no rows for a rule = all the doctor's services).
model RuleService {
  ruleId    String @db.Uuid
  serviceId String @db.Uuid

  rule    AvailabilityRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  service Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([ruleId, serviceId])
  @@index([serviceId])
  @@map("rule_services")
}

// A prepaid package definition. Editing it only affects future purchases —
// what a patient bought is snapshotted on PatientPackage / its balances.
model Package {
  id           String   @id @default(uuid()) @db.Uuid
  clinicId     String   @db.Uuid
  categoryId   String   @db.Uuid
  name         String
  description  String? // public
  terms        String? // public: usage / refund terms
  agentNotes   String? // AI agent only
  price        Decimal  @db.Decimal(10, 2)
  validityDays Int
  allBranches  Boolean  @default(true)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clinic          Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  branches        PackageBranch[]
  items           PackageItem[]
  offerTargets    OfferTarget[]
  patientPackages PatientPackage[]

  @@unique([clinicId, name])
  @@index([clinicId])
  @@index([categoryId])
  @@map("packages")
}

model PackageBranch {
  packageId String   @db.Uuid
  branchId  String   @db.Uuid
  price     Decimal? @db.Decimal(10, 2)

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([packageId, branchId])
  @@index([branchId])
  @@map("package_branches")
}

// One credit line of a package. Spendable on every service of `categoryId`, or
// (when categoryId is null) on the services listed in PackageItemService.
model PackageItem {
  id         String     @id @default(uuid()) @db.Uuid
  packageId  String     @db.Uuid
  creditType CreditType
  quantity   Int
  categoryId String?    @db.Uuid

  package  Package              @relation(fields: [packageId], references: [id], onDelete: Cascade)
  category Category?            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  services PackageItemService[]

  @@index([packageId])
  @@map("package_items")
}

model PackageItemService {
  packageItemId String @db.Uuid
  serviceId     String @db.Uuid

  packageItem PackageItem @relation(fields: [packageItemId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([packageItemId, serviceId])
  @@index([serviceId])
  @@map("package_item_services")
}

// A package a patient owns. Usable only in `branchId`, until `expiresAt`.
// Payment is tracked separately and never blocks usage.
model PatientPackage {
  id                String               @id @default(uuid()) @db.Uuid
  clinicId          String               @db.Uuid
  patientId         String               @db.Uuid
  packageId         String?              @db.Uuid // null for OFFER rewards
  branchId          String               @db.Uuid
  name              String // snapshot of the package name (or reward label)
  source            PatientPackageSource @default(PURCHASE)
  offerId           String?              @db.Uuid // offer applied at purchase / that granted it
  basePrice         Decimal              @db.Decimal(10, 2)
  pricePaid         Decimal              @db.Decimal(10, 2)
  purchasedAt       DateTime             @default(now())
  expiresAt         DateTime
  status            PatientPackageStatus @default(ACTIVE)
  paymentStatus     PackagePaymentStatus @default(UNPAID)
  paidAt            DateTime?
  paidConfirmedById String?              @db.Uuid
  soldById          String?              @db.Uuid // null = requested by the patient
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  clinic           Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient          Profile                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  package          Package?                @relation(fields: [packageId], references: [id], onDelete: SetNull)
  branch           Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  offer            Offer?                  @relation(fields: [offerId], references: [id], onDelete: SetNull)
  balances         PatientPackageBalance[]
  appointmentItems AppointmentItem[]

  @@index([clinicId, patientId])
  @@index([branchId])
  @@index([status, expiresAt])
  @@map("patient_packages")
}

// One credit line of an owned package; coverage snapshotted from PackageItem.
// available = total - used - reserved.
model PatientPackageBalance {
  id               String     @id @default(uuid()) @db.Uuid
  patientPackageId String     @db.Uuid
  creditType       CreditType
  total            Int
  used             Int        @default(0)
  reserved         Int        @default(0) // SESSIONS only
  categoryId       String?    @db.Uuid // coverage snapshot
  serviceIds       String[]   @db.Uuid // coverage snapshot (when categoryId is null)

  patientPackage   PatientPackage    @relation(fields: [patientPackageId], references: [id], onDelete: Cascade)
  ledger           PackageLedger[]
  appointmentItems AppointmentItem[]

  @@index([patientPackageId])
  @@map("patient_package_balances")
}

// Every change to a balance — who, why, and which visit line.
model PackageLedger {
  id                String            @id @default(uuid()) @db.Uuid
  clinicId          String            @db.Uuid
  balanceId         String            @db.Uuid
  appointmentItemId String?           @db.Uuid
  type              PackageLedgerType
  quantity          Int // signed effect on the balance (0 for EXTEND)
  note              String?
  createdById       String?           @db.Uuid
  createdAt         DateTime          @default(now())

  clinic          Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  balance         PatientPackageBalance @relation(fields: [balanceId], references: [id], onDelete: Cascade)
  appointmentItem AppointmentItem?      @relation(fields: [appointmentItemId], references: [id], onDelete: SetNull)

  @@index([balanceId, createdAt])
  @@index([appointmentItemId])
  @@index([clinicId])
  @@map("package_ledger")
}

// A discount on services / packages / whole categories. Status is derived:
// paused (isActive=false), scheduled, active, expired. Overlapping active offers
// on the same target + branch are refused at the service layer.
model Offer {
  id                 String    @id @default(uuid()) @db.Uuid
  clinicId           String    @db.Uuid
  name               String // internal
  label              String // shown to patients
  type               OfferType
  value              Decimal?  @db.Decimal(10, 2)
  buyQty             Int?
  getQty             Int?
  rewardValidityDays Int?
  startsAt           DateTime? // null + null = always on
  endsAt             DateTime?
  isActive           Boolean   @default(true)
  allBranches        Boolean   @default(true)
  createdById        String?   @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  clinic           Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  branches         OfferBranch[]
  targets          OfferTarget[]
  appointmentItems AppointmentItem[]
  patientPackages  PatientPackage[]

  @@index([clinicId])
  @@map("offers")
}

model OfferBranch {
  offerId  String @db.Uuid
  branchId String @db.Uuid

  offer  Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([offerId, branchId])
  @@index([branchId])
  @@map("offer_branches")
}

// Exactly one of serviceId / packageId / categoryId per row.
model OfferTarget {
  id         String  @id @default(uuid()) @db.Uuid
  offerId    String  @db.Uuid
  serviceId  String? @db.Uuid
  packageId  String? @db.Uuid
  categoryId String? @db.Uuid

  offer    Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  package  Package?  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@index([serviceId])
  @@index([packageId])
  @@index([categoryId])
  @@map("offer_targets")
}

// One service line of an appointment. Prices, offer and duration are snapshots
// taken at booking; final* are filled by the completion modal.
model AppointmentItem {
  id                  String          @id @default(uuid()) @db.Uuid
  clinicId            String          @db.Uuid
  appointmentId       String          @db.Uuid
  serviceId           String          @db.Uuid
  serviceName         String // snapshot
  doctorId            String?         @db.Uuid // v1: always the appointment's doctor
  quantity            Int             @default(1)
  basePrice           Decimal?        @db.Decimal(10, 2)
  offerId             String?         @db.Uuid
  discount            Decimal?        @db.Decimal(10, 2)
  unitPrice           Decimal?        @db.Decimal(10, 2)
  total               Decimal?        @db.Decimal(10, 2) // estimated (null = decided at the visit)
  durationMin         Int
  // Paid from a package (null = paid normally).
  patientPackageId    String?         @db.Uuid
  balanceId           String?         @db.Uuid
  // Completion.
  finalQuantity       Int?
  finalTotal          Decimal?        @db.Decimal(10, 2)
  uncoveredQuantity   Int? // used beyond the package balance (not charged for now)
  // Pre-check (Service.preCheckServiceId): the pre-check line itself is
  // isPreCheck; the line that needs it carries preCheckStatus (PENDING until
  // the practitioner decides at the visit). null = no decision needed.
  isPreCheck          Boolean         @default(false)
  preCheckStatus      PreCheckStatus?
  preCheckNote        String?
  preCheckDecidedAt   DateTime?
  preCheckDecidedById String?         @db.Uuid
  sortOrder           Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  clinic         Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment    Appointment            @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service        Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  doctor         Doctor?                @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  offer          Offer?                 @relation(fields: [offerId], references: [id], onDelete: SetNull)
  patientPackage PatientPackage?        @relation(fields: [patientPackageId], references: [id], onDelete: SetNull)
  balance        PatientPackageBalance? @relation(fields: [balanceId], references: [id], onDelete: SetNull)
  ledger         PackageLedger[]

  @@index([appointmentId])
  @@index([serviceId])
  @@index([serviceId, preCheckStatus])
  @@index([patientPackageId])
  @@index([clinicId])
  @@map("appointment_items")
}

// A file attached to a visit — lab result, x-ray, scanned document. Uploaded by
// clinic staff (doctor/admin) from the appointment page. The bytes live in the
// private `patient-media` bucket (see lib/supabase/storage.ts); this row holds
// only a pointer (`storagePath`) plus metadata, read back via short-lived signed
// URLs. Cascades with its appointment so deleting a visit drops its files' rows.
model AppointmentAttachment {
  id            String   @id @default(uuid()) @db.Uuid
  clinicId      String   @db.Uuid
  appointmentId String   @db.Uuid
  // The Profile (staff member) that uploaded it. Restrict: keep the record's
  // provenance even if the uploader's profile is later removed elsewhere.
  uploadedById  String   @db.Uuid
  // Object path within the private bucket: `<clinicId>/appointments/<appointmentId>/<uuid>.<ext>`.
  storagePath   String
  fileName      String // original filename, for display + download
  contentType   String // base mime type
  size          Int // byte length
  // Coarse category for the UI: "image" | "pdf" | "document".
  kind          String
  createdAt     DateTime @default(now())

  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  uploadedBy  Profile     @relation("UploadedAttachments", fields: [uploadedById], references: [id])

  @@index([clinicId, appointmentId])
  @@index([appointmentId])
  @@map("appointment_attachments")
}

model Conversation {
  id             String           @id @default(uuid()) @db.Uuid
  clinicId       String           @db.Uuid
  userId         String?          @db.Uuid
  whatsappPhone  String?
  // Meta Business-Scoped User ID (BSUID). Since the WhatsApp usernames rollout,
  // contacts messaging with a username hidden phone arrive with only this id
  // (format "CC.alphanumeric") and no phone — so it, not the phone, is the
  // stable per-clinic key for those threads. Null for web + legacy WhatsApp rows.
  whatsappUserId String?
  whatsappName   String?
  channel        Channel
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  // The team member this conversation is assigned to (clinic-wide, everyone
  // sees it). Null = unassigned. Assigning does NOT pause the AI.
  assignedToId   String?          @db.Uuid
  assignedById   String?          @db.Uuid
  assignedAt     DateTime?
  // CUSTOMER = a patient/contact thread (the inbox). STAFF_ASSISTANT = a team
  // member's own chat with the team assistant (#89) — never shown in the inbox,
  // never escalated, billed as STAFF_REPLY.
  kind           ConversationKind @default(CUSTOMER)

  clinic         Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user           Profile?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTo     Profile?                @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedBy     Profile?                @relation("ConversationAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  messages       Message[]
  sessions       ChatSession[]
  escalations    Escalation[]
  processing     ConversationProcessing?
  pins           ConversationPin[]
  labels         ConversationLabel[]
  reminders      ConversationReminder[]
  internalNotes  InternalNote[]
  messageNotes   MessageNote[]
  staffAlerts    StaffAlert[]
  pendingActions StaffPendingAction[]

  @@unique([clinicId, whatsappPhone])
  @@unique([clinicId, whatsappUserId])
  @@unique([clinicId, userId, channel])
  @@index([clinicId])
  @@index([clinicId, kind])
  @@index([assignedToId])
  @@index([assignedById])
  @@map("conversations")
}

// A bounded chat window (fixed 30-min from its first message) used to scope
// LLM context and to group messages with dividers in the admin inbox.
model ChatSession {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  clinicId       String    @db.Uuid
  startedAt      DateTime  @default(now())
  expiresAt      DateTime // startedAt + SESSION_MINUTES (env, default 30 min)
  // AI auto-reply for this session. Defaults on for every new session; the
  // admin can pause it, or the escalate_to_human tool turns it off when the
  // user asks for a human. Does not carry over to the next session.
  aiEnabled      Boolean   @default(true)
  // The staff member who last paused / resumed the AI by hand, and when. Null
  // when the flag was never toggled manually (default, or the escalation tool).
  aiToggledById  String?   @db.Uuid
  aiToggledAt    DateTime?

  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  aiToggledBy  Profile?     @relation("SessionAiToggler", fields: [aiToggledById], references: [id], onDelete: SetNull)
  messages     Message[]
  escalations  Escalation[]
  aiUsage      AiUsageLog[]

  @@index([conversationId])
  @@index([clinicId])
  @@map("chat_sessions")
}

// One row per escalate_to_human request. A session can have several — e.g.
// user escalates, admin re-enables the AI, user escalates again.
model Escalation {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  sessionId      String       @db.Uuid
  clinicId       String       @db.Uuid
  // The specific inbound message that triggered this escalation, when there is
  // one (media the agent can't read). Lets the inbox mark that exact bubble and
  // offer a per-message "resolve" button. Null for session-level escalations
  // (the escalate_to_human tool, or the credit/AI-off gates).
  messageId      String?      @db.Uuid
  reason         String?
  createdAt      DateTime     @default(now())
  // Set when an admin re-enables the AI for the session or sends a manual
  // reply in the conversation — whichever happens first. Null = still open.
  resolvedAt     DateTime?
  // The staff member whose action resolved it (reply / resolve button / AI
  // re-enable). Null while open, and for escalations resolved before this
  // column existed.
  resolvedById   String?      @db.Uuid
  clinic         Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  session        ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  resolvedBy     Profile?     @relation("EscalationResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([sessionId])
  @@index([clinicId])
  @@index([messageId])
  @@map("escalations")
}

model Message {
  id                String          @id @default(uuid()) @db.Uuid
  conversationId    String          @db.Uuid
  clinicId          String          @db.Uuid
  sessionId         String?         @db.Uuid
  senderType        SenderType
  senderId          String?         @db.Uuid // null when senderType = AGENT
  content           String
  metadata          Json? // { toolCalls, voice, media, structured, reaction } — see agent/types.ts
  // The WhatsApp Cloud API message id (wamid) for messages that came in on / went
  // out over WhatsApp. Lets an inbound reaction (which references the reacted
  // message by wamid) be attached to the right message. Null for web messages.
  whatsappMessageId String?         @db.Text
  // The clinic WhatsApp number this message came in on / went out from (a clinic
  // can have several). Picks the default sender for a reply. Null for web
  // messages and for WhatsApp messages from before numbers were tracked.
  whatsappConfigId  String?         @db.Uuid
  isRead            Boolean         @default(false)
  createdAt         DateTime        @default(now())
  // Debounce bookkeeping. On an inbound USER message, null until the debounce
  // processor has consolidated it into an agent reply — the race-safe marker of
  // "already answered" (set by explicit id, so a message that arrives mid-run is
  // never marked and gets its own reply next tick). Null on AGENT messages.
  processedAt       DateTime?
  // Delivery lifecycle of an outbound AGENT reply. QUEUED = generated + persisted
  // but not yet sent (the checkpoint that lets a send-retry re-deliver WITHOUT
  // re-running/charging the AI); SENT once the Cloud API accepts it; FAILED after
  // a send error. Always SENT for inbound + web messages.
  deliveryStatus    MessageDelivery @default(SENT)
  sendAttempts      Int             @default(0)
  // The AI employee that wrote this AGENT reply (inbox attribution). Null for
  // USER/ADMIN messages, system notices, and replies sent before AI employees
  // existed.
  aiAgentId         String?         @db.Uuid
  // The earlier message this one quotes (a WhatsApp "reply" bubble, or a staff
  // reply picked from the inbox). Inbound: resolved from Meta's
  // `messages[].context.id` wamid. Null for plain messages, and when the quoted
  // message isn't one we stored — the reply is still kept, just without a link.
  // Distinct from reactions, which attach to their target via metadata.
  replyToId         String?         @db.Uuid

  aiAgent        AiAgent?        @relation(fields: [aiAgentId], references: [id], onDelete: SetNull)
  whatsappConfig WhatsappConfig? @relation(fields: [whatsappConfigId], references: [id], onDelete: SetNull)
  replyTo        Message?        @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]       @relation("MessageReplies")
  clinic         Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  session        ChatSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sender         Profile?        @relation("SenderProfile", fields: [senderId], references: [id], onDelete: SetNull)
  aiUsage        AiUsageLog[]
  escalations    Escalation[]
  notes          MessageNote[]
  staffAlerts    StaffAlert[]

  @@index([conversationId])
  @@index([sessionId])
  @@index([clinicId, createdAt])
  @@index([conversationId, whatsappMessageId])
  // The history import's "already stored?" check, across the whole clinic.
  @@index([clinicId, whatsappMessageId])
  @@index([conversationId, whatsappConfigId, createdAt])
  @@index([replyToId])
  // Serves the processor's "unprocessed user messages in this session" read and
  // the "is there an undelivered reply to resume" resume-check.
  @@index([sessionId, processedAt])
  @@index([sessionId, deliveryStatus])
  @@map("messages")
}

// Delivery lifecycle of an outbound agent reply — see Message.deliveryStatus.
enum MessageDelivery {
  QUEUED
  SENT
  FAILED
}

// Per-conversation debounce + retry controller. ONE row per conversation. This
// is NOT ChatSession (a 30-min context window): it governs *when* to answer a
// burst of messages and how to retry a failed reply. Driven by pg_cron (every
// ~15s) → /api/cron/process-debounce. See memory message-debounce-pgcron.
model ConversationProcessing {
  conversationId      String                       @id @db.Uuid
  clinicId            String                       @db.Uuid
  status              ConversationProcessingStatus @default(IDLE)
  // Raw timestamp of the most recent answerable inbound message (debugging).
  lastInboundAt       DateTime
  // The debounce gate: = lastInboundAt + clinic.debounceSeconds, recomputed on
  // every inbound. The processor claims rows whose readyAt <= now(). Storing it
  // (instead of an interval in SQL) keeps per-clinic windows out of the hot query
  // and makes a clinic's live debounce change take effect on the next message.
  readyAt             DateTime
  // Reply-modality hint: was the last inbound a voice note? (→ maybe TTS reply.)
  lastInboundWasVoice Boolean                      @default(false)
  // When a processor run claimed this row — for stuck-run recovery.
  claimedAt           DateTime?
  retryCount          Int                          @default(0)
  // Constant-backoff gate: don't retry before this. Null = eligible now.
  nextRetryAt         DateTime?
  lastError           String?
  updatedAt           DateTime                     @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  // The hot discovery query: due PENDING rows, oldest-waiting first.
  @@index([status, readyAt])
  @@index([status, nextRetryAt])
  @@index([clinicId])
  @@map("conversation_processing")
}

enum ConversationProcessingStatus {
  IDLE // nothing waiting to answer
  PENDING // unanswered inbound message(s) in the debounce window
  PROCESSING // claimed by a processor run
  FAILED // retries exhausted — needs human attention
}

// ─── AI credit & cost metering ────────────────────────────────────────────────

// 1:1 satellite of Clinic (mirrors WhatsappConfig). Holds the per-clinic global
// AI on/off switch (clinic-admin controlled) and the clinic's unit meter.
//
// `unitBalance` (Int) is what a CLINIC is granted, sees and spends: one unit per
// agent reply, whatever that reply actually cost. Its source of truth is
// AiUnitLedger (SUM(ledger.amount) must equal it). It is the only meter, and
// the only thing that gates the agent (see getClinicAiStatus). The real USD
// cost of each call is telemetry on AiUsageLog.rawCost — never charged.
model ClinicAiCredit {
  id                    String    @id @default(uuid()) @db.Uuid
  clinicId              String    @unique @db.Uuid
  // Per-clinic global AI auto-reply switch. Distinct from ChatSession.aiEnabled
  // (a per-session pause) — this turns the agent off across the whole clinic.
  aiEnabled             Boolean   @default(true)
  // Per-clinic voice-reply (TTS) switch. When true AND the patient's turn was a
  // voice message, the agent answers with synthesized speech; text-in always
  // yields text-out. Default off so no clinic pays for TTS unexpectedly.
  voiceReplyEnabled     Boolean   @default(false)
  // Per-clinic image-analysis switch. When true AND the patient sent an image,
  // the agent reads it (a one-time vision call describes it, EXTRACTION-billed)
  // and answers from that description. When off, the image is still archived but
  // never read — the agent only answers any caption text and a human is
  // escalated. Default off so no clinic pays for vision unexpectedly.
  imageAnalysisEnabled  Boolean   @default(false)
  // Second image controller (issue: two image modes). Only meaningful when
  // imageAnalysisEnabled is true. When true, the agent answers from the extracted
  // description (extract-and-respond — the historical behaviour, hence default
  // true). When false, the image is still OCR'd and the extraction is stored on
  // the message for the call-centre team to read (e.g. a hard-to-read
  // prescription), but the agent does NOT auto-reply — the thread is escalated to
  // a human instead. Off(imageAnalysisEnabled=false) ignores this flag entirely.
  imageAutoReplyEnabled Boolean   @default(true)
  // The clinic-facing meter: remaining agent replies. Decremented by exactly 1
  // inside the same transaction that logs a REPLY usage row, so a redelivered
  // webhook that fails the (messageId, kind) unique rolls the unit back too.
  // Starts at 0 — a clinic replies only once the platform grants it units.
  unitBalance           Int       @default(0)
  // Soft warning for the clinic admin's dashboard; does not block replies.
  lowUnitsThreshold     Int       @default(50)
  // Dedupe stamps for the platform-admin low-credit alert emails. Set when the
  // alert is sent, cleared by a top-up that lifts the balance back above the
  // threshold — so each crossing mails once, not once per reply below it.
  // The two events are distinct: "running low, top them up" vs "units gone, the
  // agent has stopped answering this clinic's customers".
  lowUnitsNotifiedAt    DateTime?
  unitsOutNotifiedAt    DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("clinic_ai_credits")
}

// Append-only usage/cost analytics — one row per AI call (reply, transcription,
// TTS, image extraction). Stores the token counts, the rate snapshots (so
// historical cost stays correct if pricing changes later) and the raw OpenAI
// cost. (messageId, kind) is unique: a webhook redelivery that re-charges the
// same reply hits the constraint and rolls the whole txn back.
model AiUsageLog {
  id                  String      @id @default(uuid()) @db.Uuid
  clinicId            String      @db.Uuid
  sessionId           String?     @db.Uuid
  messageId           String?     @db.Uuid
  // What this row bills for. A message can now carry more than one usage row
  // (a voice message: TRANSCRIPTION on the inbound + REPLY/TTS on the answer),
  // so idempotency is (messageId, kind) rather than messageId alone.
  kind                AiUsageKind @default(REPLY)
  model               String
  // Token columns are REPLY-shaped and null for audio rows.
  promptTokens        Int?
  completionTokens    Int?
  totalTokens         Int?
  // The share of promptTokens served from OpenAI's prompt cache (billed at
  // cachedInputRatePerM, not inputRatePerM). Null on audio rows and on rows
  // written before cached tokens were captured — those billed every prompt
  // token at the full input rate.
  cachedInputTokens   Int?
  // Billed audio length for TRANSCRIPTION/TTS rows; null for REPLY rows.
  audioSeconds        Int?
  inputRatePerM       Decimal     @db.Decimal(12, 4)
  // Snapshot of the cached-input list rate; null wherever cachedInputTokens is.
  cachedInputRatePerM Decimal?    @db.Decimal(12, 4)
  outputRatePerM      Decimal     @db.Decimal(12, 4)
  // Real OpenAI list cost of this call (USD, Decimal — never a JS float).
  // Telemetry only: clinics are charged in units, never in dollars.
  rawCost             Decimal     @db.Decimal(18, 8)
  // Units this row cost the clinic: 1 on REPLY rows, 0 on TRANSCRIPTION/TTS
  // (the platform absorbs those in USD). Denormalized here so unit reporting is
  // one aggregate over the same table as cost reporting, with no join.
  unitsCharged        Int         @default(0)
  // The AI employee whose reply this row bills (REPLY rows). Drives the
  // per-agent usage caps and the "which agent answered most" reports; the unit
  // ledger reaches it through its usageId. Null on rows not tied to
  // an agent (transcription/extraction happen before one is chosen) and on rows
  // written before AI employees existed.
  aiAgentId           String?     @db.Uuid
  createdAt           DateTime    @default(now())

  aiAgent    AiAgent?      @relation(fields: [aiAgentId], references: [id], onDelete: SetNull)
  clinic     Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  session    ChatSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  message    Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  unitLedger AiUnitLedger?

  @@unique([messageId, kind])
  @@index([clinicId, createdAt])
  @@index([aiAgentId, createdAt])
  @@map("ai_usage_logs")
}

// Append-only UNIT ledger — the SOURCE OF TRUTH for ClinicAiCredit.unitBalance.
// `amount` is signed (+topup, -1 per agent reply, ± adjustment); `balanceAfter`
// snapshots the running unit count right after this entry.
//
// USAGE rows link 1:1 to the AiUsageLog they were spent on, which is what makes
// the meter auditable: every unit a clinic lost can be traced to the exact reply
// that spent it, and to that reply's real USD cost.
model AiUnitLedger {
  id           String           @id @default(uuid()) @db.Uuid
  clinicId     String           @db.Uuid
  type         AiUnitLedgerType
  amount       Int
  balanceAfter Int
  usageId      String?          @unique @db.Uuid
  note         String?
  actorId      String?          @db.Uuid
  createdAt    DateTime         @default(now())

  clinic Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  usage  AiUsageLog? @relation(fields: [usageId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
  @@map("ai_unit_ledger")
}

// ─── Appointment automation ───────────────────────────────────────────────────

// Links one of a clinic's approved WhatsApp templates to an automation purpose,
// and records how to fill its {{n}} placeholders. Templates live only in Meta
// (there is no Template model), so this binding is what lets the sweep know WHICH
// template to send for a clinic and in WHAT ORDER to pass the variables.
//
// The confirmation/feedback flows run ONLY when an enabled binding exists for the
// clinic + purpose. No binding → that clinic's flow is inert (see the sweep's
// relation-filter gate); the appointment's dedupe flag stays null so it is still
// eligible once a binding is added.
model ClinicAppointmentTemplate {
  id           String                     @id @default(uuid()) @db.Uuid
  clinicId     String                     @db.Uuid
  purpose      AppointmentTemplatePurpose
  // The clinic's own approved template — name + language as registered in Meta.
  templateName String
  languageCode String
  // Ordered token list, one entry per {{n}} placeholder, drawn from a fixed
  // vocabulary the sweep can resolve (patient_name, doctor_name, appointment_date,
  // appointment_time, clinic_name, branch_name, branch_address, order_number, …).
  // variableMap[0] fills {{1}}, variableMap[1] fills {{2}}, and so on.
  variableMap  String[]
  // Snapshot of the template's text (header / body / footer with {{n}}
  // placeholders) taken from Meta when the admin saves the binding. Lets the
  // sender render the exact message locally — for the admin inbox thread —
  // without a per-send Graph API call to fetch the template body.
  bodyText     String                     @default("")
  headerText   String                     @default("")
  footerText   String                     @default("")
  enabled      Boolean                    @default(true)
  // CONFIRM_REMINDER: how long before the visit to send (minutes; 1440 = 24h).
  leadMinutes  Int                        @default(1440)
  // FEEDBACK_REQUEST: how long after completion to send (minutes).
  delayMinutes Int                        @default(120)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  // At most one binding per (clinic, purpose).
  @@unique([clinicId, purpose])
  @@index([clinicId])
  @@map("clinic_appointment_templates")
}

// ─── Patient health profile (ملف المريض) ──────────────────────────────────────
//
// Each clinic builds its own questionnaire (sections → questions; built by
// platform admins for now) and each patient has one file per clinic holding
// their answers. Logic lives in lib/health-profile.ts.
//
// SAFE EDITING. Questions answered by patients must never break those answers:
//  - Sections/questions are ARCHIVED (archivedAt), never hard-deleted once
//    answered — the answer FK is NO ACTION, so the DB enforces it.
//  - Every answer stores `questionSnapshot` (label/type/options at the time it
//    was answered), so renamed or archived questions still render faithfully.
//  - Dropdown options carry stable ids inside `config`; renaming an option
//    keeps its id, removing one archives it.
//  - A question's `type` can't change once it has answers (enforced in the
//    service) — archive it and add a new one instead.
//
// BOOKING GATE. Only REQUIRED, PATIENT-audience, non-archived questions gate a
// booking, and only for a patient with no prior appointment at the clinic.
// Completeness is computed, never stored, so adding a required question
// later needs no backfill.

// TEXT/NUMBER/SELECT/BOOLEAN. SELECT is a single-choice dropdown.
enum HealthQuestionType {
  TEXT
  NUMBER
  SELECT
  BOOLEAN
}

// Who the question is for. PATIENT: asked to the patient (web + AI agent) and
// visible to staff. STAFF: filled by clinic staff only — the patient never
// sees it and the agent never asks it or reveals it.
enum HealthQuestionAudience {
  PATIENT
  STAFF
}

// Which surface wrote an answer — for the edit history.
enum HealthAnswerSource {
  PATIENT
  STAFF
  AGENT
}

model HealthProfileSection {
  id          String    @id @default(uuid()) @db.Uuid
  clinicId    String    @db.Uuid
  title       String
  description String?
  sortOrder   Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  clinic    Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  questions HealthProfileQuestion[]

  @@index([clinicId, sortOrder])
  @@map("health_profile_sections")
}

// One question in a clinic's health profile.
//
// Type-specific settings are real, typed columns (not a JSON blob), so the DB
// checks them and there is no "old config shape" to migrate later. Each one is
// used by a single type and left null/default for the others:
//   NUMBER → minValue, maxValue, unit      (e.g. 0..300 "kg")
//   TEXT   → multiline, placeholder
//   SELECT → its options live in HealthQuestionOption (own table)
// Changing a setting never touches existing answers: they keep their value and
// their questionSnapshot; new bounds only apply to new saves.
model HealthProfileQuestion {
  id          String                 @id @default(uuid()) @db.Uuid
  clinicId    String                 @db.Uuid
  sectionId   String                 @db.Uuid
  // FOLLOW-UP QUESTIONS. `parentId` points to a BOOLEAN question this one sits
  // under; null for a normal question. `showWhen` is the parent answer that
  // reveals it: true = shown when the parent is answered "yes", false = shown
  // on "no". Both null for normal questions, both set for follow-ups. One
  // level deep only. Example:
  //   Q1 "Do you have a chronic disease?"  BOOLEAN  parentId=null
  //   Q2 "Please describe it"              TEXT     parentId=Q1  showWhen=true
  // A hidden follow-up is never required, even if `required` is set.
  parentId    String?                @db.Uuid
  showWhen    Boolean?
  label       String
  helpText    String?
  type        HealthQuestionType
  audience    HealthQuestionAudience @default(PATIENT)
  required    Boolean                @default(false)
  sortOrder   Int                    @default(0)
  // NUMBER settings.
  minValue    Float?
  maxValue    Float?
  unit        String?
  // TEXT settings.
  multiline   Boolean                @default(false)
  placeholder String?
  archivedAt  DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  clinic    Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  section   HealthProfileSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  parent    HealthProfileQuestion?  @relation("HealthQuestionFollowUps", fields: [parentId], references: [id], onDelete: Cascade)
  followUps HealthProfileQuestion[] @relation("HealthQuestionFollowUps")
  options   HealthQuestionOption[]
  answers   PatientHealthAnswer[]

  @@index([sectionId, sortOrder])
  @@index([clinicId])
  @@index([parentId])
  @@map("health_profile_questions")
}

// One choice of a SELECT (dropdown) question. Renaming keeps the row (and so
// every answer pointing at it); removing ARCHIVES it — it disappears from the
// form but old answers still resolve. The answer FK is NO ACTION, so the DB
// refuses to delete an option someone picked.
model HealthQuestionOption {
  id         String    @id @default(uuid()) @db.Uuid
  clinicId   String    @db.Uuid
  questionId String    @db.Uuid
  label      String
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  clinic   Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  question HealthProfileQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  PatientHealthAnswer[]

  @@index([questionId, sortOrder])
  @@index([clinicId])
  @@map("health_question_options")
}

// A patient's file at one clinic. Created on first answer.
model PatientHealthProfile {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @db.Uuid
  patientId String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic  Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Profile               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  answers PatientHealthAnswer[]

  @@unique([clinicId, patientId])
  @@index([patientId])
  @@map("patient_health_profiles")
}

// The CURRENT answer to one question in one file. At most one of these is set
// (DB CHECK constraint); both null = the answer was cleared — the row is kept
// so its edit history (revisions cascade with it) survives:
//   - `optionId` for a SELECT question — a real FK to the chosen option.
//   - `value` for TEXT / NUMBER / BOOLEAN — a JSON scalar ("text" | 72 | true),
//     validated against the question type before every save.
// `questionSnapshot` freezes the question as it was answered (label, type,
// chosen option label, unit…) — read-only display data, so renamed or
// archived questions still render faithfully.
// `source` is HOW it was written (patient web / staff dashboard / AI agent);
// `updatedById` is WHO (for AGENT that is the patient the agent acts for).
// The question FK is NO ACTION (checked at statement end, so clinic/section
// cascades still work): an answered question can only be archived.
model PatientHealthAnswer {
  id               String             @id @default(uuid()) @db.Uuid
  profileId        String             @db.Uuid
  clinicId         String             @db.Uuid
  questionId       String             @db.Uuid
  optionId         String?            @db.Uuid
  value            Json?
  questionSnapshot Json
  source           HealthAnswerSource
  updatedById      String             @db.Uuid
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  clinic    Clinic                        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  profile   PatientHealthProfile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  question  HealthProfileQuestion         @relation(fields: [questionId], references: [id], onDelete: NoAction)
  option    HealthQuestionOption?         @relation(fields: [optionId], references: [id], onDelete: NoAction)
  updatedBy Profile                       @relation("HealthAnswerUpdater", fields: [updatedById], references: [id], onDelete: NoAction)
  revisions PatientHealthAnswerRevision[]

  @@unique([profileId, questionId])
  @@index([questionId])
  @@index([optionId])
  @@index([clinicId])
  @@index([updatedById])
  @@map("patient_health_answers")
}

// Edit history: one row per change to an answer. Append-only.
// `oldValue`/`newValue` are the answer before/after, as JSON so one column fits
// every type: text, number, boolean, or — for SELECT — the option id (options
// are never deleted, so it always resolves). null = no answer: oldValue null
// on the first write, newValue null when the answer was cleared.
model PatientHealthAnswerRevision {
  id         String             @id @default(uuid()) @db.Uuid
  answerId   String             @db.Uuid
  clinicId   String             @db.Uuid
  oldValue   Json?
  newValue   Json?
  source     HealthAnswerSource
  editedById String             @db.Uuid
  editedAt   DateTime           @default(now())

  clinic   Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  answer   PatientHealthAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  editedBy Profile             @relation("HealthAnswerEdits", fields: [editedById], references: [id], onDelete: NoAction)

  @@index([answerId, editedAt])
  @@index([clinicId])
  @@index([editedById])
  @@map("patient_health_answer_revisions")
}

// ─── Medical history ──────────────────────────────────────────────────────────

// What actually happened clinically during a visit — the counterpart to
// Appointment, which only ever records SCHEDULING state (booked/completed/…).
// One record per visit; a patient's timeline is their records ordered by
// `visitDate` descending.
//
// SCOPING. Like every other table here the row carries `clinicId`, and every
// read is filtered by the clinic resolved from the request host. A patient
// signed in at demo.clinica-ai.nusuqai.com sees only the records demo wrote —
// their history at another clinic is invisible, not merely unlinked. `branchId`
// is snapshotted from the originating appointment so a future branch-scoped
// staff role can filter on it without re-deriving the branch from the visit.
//
// `appointmentId` is optional and unique: normally the record is written from
// the visit it documents, but a doctor can also add a standalone record (a
// walk-in, or back-filling a paper note). It is SetNull, not Cascade — deleting
// the scheduling row must never destroy the clinical one.
//
// `doctorId` is the TREATING doctor. It is Restrict (Prisma's default on a
// required relation), so a doctor with history cannot be deleted out from under
// their records.
model TreatmentRecord {
  id                     String    @id @default(uuid()) @db.Uuid
  clinicId               String    @db.Uuid
  patientId              String    @db.Uuid
  doctorId               String    @db.Uuid
  branchId               String?   @db.Uuid
  appointmentId          String?   @unique @db.Uuid
  // The day of the visit this documents. Defaults to the appointment's date at
  // creation time, but stays editable — paper notes get back-dated.
  visitDate              DateTime  @db.Date
  chiefComplaint         String? // شكوى المريض — what they came in for, in their words
  diagnosis              String? // التشخيص — free text; no ICD coding in v1
  clinicalNotes          String? // ملاحظات الطبيب — examination findings, plan
  followUpDate           DateTime? @db.Date // موعد المتابعة المقترح
  // Dedupe flag for the follow-up reminder automation: stamped once the "time to
  // book your follow-up" WhatsApp message has gone out, so the sweep never sends
  // it twice. Cleared implicitly by editing followUpDate to a new day (the sweep
  // keys on this being null). Mirrors Appointment.reminderSentAt/feedbackRequestedAt.
  followUpReminderSentAt DateTime?
  createdById            String    @db.Uuid // the Profile that wrote it (the doctor's account)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  clinic        Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Profile                   @relation("PatientTreatmentRecords", fields: [patientId], references: [id], onDelete: Cascade)
  doctor        Doctor                    @relation(fields: [doctorId], references: [id])
  branch        Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  appointment   Appointment?              @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdBy     Profile                   @relation("AuthoredTreatmentRecords", fields: [createdById], references: [id])
  procedures    TreatmentProcedure[]
  prescriptions Prescription[]
  revisions     TreatmentRecordRevision[]

  // The patient timeline query: this clinic's records for one patient, newest
  // first. Covers the admin, doctor and patient views alike.
  @@index([clinicId, patientId, visitDate])
  @@index([clinicId, doctorId])
  @@index([branchId])
  // The follow-up reminder sweep: records with an unsent follow-up whose date is
  // near. Not-yet-sent rows sort first, then by the date being matched.
  @@index([followUpReminderSentAt, followUpDate])
  @@map("treatment_records")
}

// A procedure performed during a visit — الإجراءات المُنفَّذة. Child of one
// record; cascades with it. `cost` is optional and purely informational (there
// is no billing module yet), stored as Decimal so it is never a JS float.
model TreatmentProcedure {
  id        String        @id @default(uuid()) @db.Uuid
  recordId  String        @db.Uuid
  clinicId  String        @db.Uuid
  kind      ProcedureKind @default(OTHER)
  name      String // the clinic's own wording, e.g. "خلع ضرس العقل"
  note      String?
  cost      Decimal?      @db.Decimal(10, 2)
  createdAt DateTime      @default(now())

  clinic Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  record TreatmentRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@index([clinicId])
  @@map("treatment_procedures")
}

// One prescribed drug line — روشتة. Several rows make up the visit's
// prescription. Free-text rather than a drug catalog: a clinic writes what it
// writes, and a catalog would need per-market data we don't have.
model Prescription {
  id           String   @id @default(uuid()) @db.Uuid
  recordId     String   @db.Uuid
  clinicId     String   @db.Uuid
  drugName     String // اسم الدواء
  dose         String? // الجرعة, e.g. "500 مجم"
  frequency    String? // التكرار, e.g. "مرتين يومياً"
  durationDays Int? // مدة العلاج بالأيام
  instructions String? // تعليمات, e.g. "بعد الأكل"
  createdAt    DateTime @default(now())

  clinic Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  record TreatmentRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@index([clinicId])
  @@map("prescriptions")
}

// Append-only audit trail for TreatmentRecord. One row per edit, written in the
// SAME transaction as the update, holding a snapshot of the values as they were
// BEFORE that edit (including the procedure/prescription lines). Records stay
// editable — doctors make typos — but nothing is ever silently rewritten: the
// record's history shows who changed what and when.
//
// `snapshot` is Json rather than mirrored columns on purpose: it must keep
// meaning even after the record's own shape changes, and it is only ever read
// back for display, never queried into.
model TreatmentRecordRevision {
  id         String   @id @default(uuid()) @db.Uuid
  recordId   String   @db.Uuid
  clinicId   String   @db.Uuid
  editedById String   @db.Uuid
  editedAt   DateTime @default(now())
  snapshot   Json

  clinic   Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  record   TreatmentRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  editedBy Profile         @relation("TreatmentRecordEdits", fields: [editedById], references: [id])

  @@index([recordId, editedAt])
  @@index([clinicId])
  @@map("treatment_record_revisions")
}

// A patient's feedback for a completed appointment. One row per appointment
// (created when the patient replies to the feedback message, via the agent's
// submit_appointment_feedback tool). rating/comment are both optional so a
// patient can leave a star rating, a comment, or both.
model AppointmentFeedback {
  id            String   @id @default(uuid()) @db.Uuid
  appointmentId String   @unique @db.Uuid
  clinicId      String   @db.Uuid
  patientId     String   @db.Uuid
  rating        Int? // e.g. 1–5, if the clinic's template asks for a score
  comment       String?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Profile     @relation(fields: [patientId], references: [id])

  @@index([clinicId])
  @@index([patientId])
  @@map("appointment_feedback")
}

// ─── Inbox utilities ─────────────────────────────────────────────────────────
// Staff-side collaboration on conversations. None of these tables is ever read
// by the agent or sent to the patient: they are invisible outside the dashboard.

// Who can see a reminder / message note: only its author, or the whole team.
enum NoteVisibility {
  PRIVATE
  CLINIC
}

// A conversation pinned to the top of ONE team member's inbox (per user).
model ConversationPin {
  userId         String   @db.Uuid
  conversationId String   @db.Uuid
  clinicId       String   @db.Uuid
  createdAt      DateTime @default(now())

  user         Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@id([userId, conversationId])
  @@index([conversationId])
  @@index([clinicId, userId])
  @@map("conversation_pins")
}

// A personal label (name + colour) a team member files conversations under.
// Labels belong to their owner — colleagues never see them.
model InboxLabel {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @db.Uuid
  ownerId   String   @db.Uuid
  name      String
  // One of the palette keys in lib/inbox-labels.ts (not a raw hex).
  color     String
  createdAt DateTime @default(now())

  clinic        Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  owner         Profile             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversations ConversationLabel[]

  @@unique([clinicId, ownerId, name])
  @@index([ownerId])
  @@map("inbox_labels")
}

model ConversationLabel {
  labelId        String   @db.Uuid
  conversationId String   @db.Uuid
  createdAt      DateTime @default(now())

  label        InboxLabel   @relation(fields: [labelId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([labelId, conversationId])
  @@index([conversationId])
  @@map("conversation_labels")
}

// "Check back on this conversation at <dueAt>", with an optional note. PRIVATE
// = only its creator sees it; CLINIC = the whole team sees it (only the creator
// is alerted). Once due and not done, the conversation floats to the top.
model ConversationReminder {
  id                 String         @id @default(uuid()) @db.Uuid
  clinicId           String         @db.Uuid
  conversationId     String         @db.Uuid
  createdById        String         @db.Uuid
  dueAt              DateTime
  note               String?
  visibility         NoteVisibility @default(PRIVATE)
  doneAt             DateTime?
  doneById           String?        @db.Uuid
  // When the due reminder was queued as a WhatsApp alert to its creator (#89),
  // so the sweep queues it once.
  whatsappNotifiedAt DateTime?
  createdAt          DateTime       @default(now())

  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdBy    Profile      @relation("ReminderCreator", fields: [createdById], references: [id], onDelete: Cascade)
  doneBy       Profile?     @relation("ReminderCompleter", fields: [doneById], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([clinicId, doneAt, dueAt])
  @@index([createdById, doneAt])
  @@index([doneById])
  @@map("conversation_reminders")
}

// A staff-only message inside a conversation thread (clinic-wide). Kept in its
// own table — never in `messages` — so it can't reach the patient, the agent's
// context, WhatsApp, unread counts or the 24h window.
model InternalNote {
  id             String   @id @default(uuid()) @db.Uuid
  clinicId       String   @db.Uuid
  conversationId String   @db.Uuid
  authorId       String?  @db.Uuid
  content        String
  createdAt      DateTime @default(now())

  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       Profile?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([clinicId])
  @@index([authorId])
  @@map("internal_notes")
}

// A note pinned to one message — PRIVATE (its author only) or CLINIC (team).
model MessageNote {
  id             String         @id @default(uuid()) @db.Uuid
  clinicId       String         @db.Uuid
  conversationId String         @db.Uuid
  messageId      String         @db.Uuid
  authorId       String         @db.Uuid
  content        String
  visibility     NoteVisibility @default(PRIVATE)
  createdAt      DateTime       @default(now())

  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  author       Profile      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([messageId])
  @@index([clinicId])
  @@index([authorId])
  @@map("message_notes")
}

// The clinic's pool of saved replies (offers, directions, repetitive answers).
// Anyone with `messages` uses them; only `quick_replies` holders manage them.
model QuickReply {
  id            String   @id @default(uuid()) @db.Uuid
  clinicId      String   @db.Uuid
  title         String
  content       String
  category      String?
  // Optional image, stored in the patient-media bucket under
  // <clinicId>/quick-replies/. Copied into the conversation on send.
  mediaPath     String?
  mediaMimeType String?
  mediaWidth    Int?
  mediaHeight   Int?
  usageCount    Int      @default(0)
  createdById   String?  @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdBy Profile? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@index([createdById])
  @@map("quick_replies")
}

enum StaffAlertKind {
  // A colleague escalated a message/conversation to the recipient, with a note.
  ESCALATION
  // The conversation was assigned to the recipient.
  ASSIGNMENT
}

// A notification for ONE team member, delivered over realtime (toast + sound)
// and counted in their "needs my response" filter until resolved.
model StaffAlert {
  id             String         @id @default(uuid()) @db.Uuid
  clinicId       String         @db.Uuid
  conversationId String         @db.Uuid
  // The specific message escalated, when there is one.
  messageId      String?        @db.Uuid
  recipientId    String         @db.Uuid
  actorId        String?        @db.Uuid
  kind           StaffAlertKind
  note           String?
  createdAt      DateTime       @default(now())
  // ESCALATION: the recipient replied / posted a note, or someone marked it
  // done. ASSIGNMENT: the recipient opened the conversation.
  resolvedAt     DateTime?
  resolvedById   String?        @db.Uuid

  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  recipient    Profile      @relation("StaffAlertRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor        Profile?     @relation("StaffAlertActor", fields: [actorId], references: [id], onDelete: SetNull)
  resolvedBy   Profile?     @relation("StaffAlertResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([recipientId, resolvedAt])
  @@index([conversationId])
  @@index([messageId])
  @@index([clinicId])
  @@index([actorId])
  @@index([resolvedById])
  @@map("staff_alerts")
}

// ─── Team assistant (#89) ─────────────────────────────────────────────────────
// A clinic member (ADMIN / STAFF / DOCTOR) manages the clinic by chatting with
// the AI — from their own WhatsApp (to any of the clinic's numbers) or from the
// dashboard bubble — and receives grouped WhatsApp alerts for the events the
// clinic ADMIN routed to them. See docs/staff-assistant.md.

enum ConversationKind {
  CUSTOMER
  STAFF_ASSISTANT
}

// What the team can be alerted about. ADMIN routes each event to members
// (StaffEventRecipient); COLLEAGUE_ESCALATION / ASSIGNMENT / REMINDER_DUE are
// personal and always go to the one member they concern.
enum StaffEvent {
  AI_ESCALATION
  COLLEAGUE_ESCALATION
  ASSIGNMENT
  REMINDER_DUE
  NEW_BOOKING
  PATIENT_CANCELLED
  UNITS_LOW
  UNITS_OUT
  // The scheduled patient-data report (Excel). Recipients are routed like the
  // other events, but the file is sent by the report sweep, not as an alert.
  DAILY_REPORT
  // A patient asked the AI about an operation — the team must contact them.
  OPERATION_REQUEST
}

// Per-clinic settings of the team assistant. A missing row = defaults.
model StaffAssistantSettings {
  clinicId              String   @id @db.Uuid
  // Master switch: off = no member can use the assistant (WhatsApp or bubble),
  // whatever their own flag says. Alerts are unaffected (they are routed per
  // event and stop when an event has no recipients).
  enabled               Boolean  @default(true)
  // How long alerts collect before one grouped message goes out (minutes, 1–30).
  batchMinutes          Int      @default(5)
  // Official (Cloud API) numbers only: the approved UTILITY template used to
  // reach a member whose 24h window is closed. Token per {{n}} from
  // STAFF_ALERT_TOKENS (lib/staff/alert-template.ts). Null = not bound (alerts
  // then wait until the member next writes in).
  alertTemplateName     String?
  alertTemplateLanguage String?
  alertVariableMap      String[] @default([])
  alertBodyText         String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("staff_assistant_settings")
}

// A member's own WhatsApp, proven by sending a one-time code FROM it to any of
// the clinic's numbers (works on Cloud API and WhatsApp Web alike, and captures
// hidden-number ids). Until verified only the code is set.
model MemberWhatsappLink {
  id                String    @id @default(uuid()) @db.Uuid
  clinicId          String    @db.Uuid
  memberId          String    @unique @db.Uuid
  // Digits with country code; null for a hidden-number contact.
  phone             String?
  // Meta BSUID / WhatsApp LID — the stable key when the phone is hidden.
  whatsappUserId    String?
  // The clinic number the member verified through — alerts go out from it.
  whatsappConfigId  String?   @db.Uuid
  verifiedAt        DateTime?
  linkCode          String?   @unique
  linkCodeExpiresAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  clinic         Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  member         ClinicMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  whatsappConfig WhatsappConfig? @relation(fields: [whatsappConfigId], references: [id], onDelete: SetNull)

  @@unique([clinicId, phone])
  @@unique([clinicId, whatsappUserId])
  @@index([whatsappConfigId])
  @@map("member_whatsapp_links")
}

// ADMIN's routing: which members get which (non-personal) event.
model StaffEventRecipient {
  id        String     @id @default(uuid()) @db.Uuid
  clinicId  String     @db.Uuid
  event     StaffEvent
  memberId  String     @db.Uuid
  createdAt DateTime   @default(now())

  clinic Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  member ClinicMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([event, memberId])
  @@index([clinicId, event])
  @@index([memberId])
  @@map("staff_event_recipients")
}

// One queued alert for one member. The minute sweep groups a member's unsent
// rows into ONE WhatsApp message once the oldest is `batchMinutes` old.
model StaffNotification {
  id             String     @id @default(uuid()) @db.Uuid
  clinicId       String     @db.Uuid
  memberId       String     @db.Uuid
  event          StaffEvent
  // One line, e.g. "أحمد محمد — طلب التحدث مع موظف".
  text           String
  conversationId String?    @db.Uuid
  appointmentId  String?    @db.Uuid
  // Idempotency per member (e.g. "esc:<id>") — an event is never queued twice.
  dedupeKey      String
  createdAt      DateTime   @default(now())
  // Delivered (as text, or announced by template — see detailsPending).
  sentAt         DateTime?
  // Announced by the template only: the full text goes out when the member
  // next writes in (their 24h window opens).
  detailsPending Boolean    @default(false)
  attempts       Int        @default(0)
  lastError      String?

  clinic Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  member ClinicMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, dedupeKey])
  @@index([sentAt, createdAt])
  @@index([memberId, detailsPending])
  @@index([clinicId])
  @@map("staff_notifications")
}

// A write the assistant proposed and is waiting for the member to approve
// ("نعم"). The tool that executes it only accepts an action proposed BEFORE the
// member's latest message — so the model cannot propose and execute in one turn.
model StaffPendingAction {
  id             String    @id @default(uuid()) @db.Uuid
  clinicId       String    @db.Uuid
  conversationId String    @db.Uuid
  actorId        String    @db.Uuid
  tool           String
  args           Json
  summary        String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  // Executed or dropped.
  consumedAt     DateTime?

  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actor        Profile      @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([conversationId, consumedAt])
  @@index([clinicId])
  @@index([actorId])
  @@map("staff_pending_actions")
}

// ─── Patient-data export & scheduled report ─────────────────────────────────
// Design: docs/data-export.md.

// Which day the scheduled report covers.
enum DataReportCoverage {
  TODAY // the clinic day up to the send time (e.g. sent at 22:00)
  YESTERDAY // the whole previous day (e.g. sent at 08:00)
}

// Per-clinic schedule of the patient-data report. A missing row = off.
// Recipients are StaffEventRecipient rows with event DAILY_REPORT.
model DataReportSettings {
  clinicId   String             @id @db.Uuid
  enabled    Boolean            @default(false)
  // Send time, minutes after midnight on the clinic's clock (1320 = 22:00).
  sendMinute Int                @default(1320)
  coverage   DataReportCoverage @default(TODAY)
  // The clinic-local day the report was last queued for — never twice a day.
  lastRunOn  DateTime?          @db.Date
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("data_report_settings")
}

// One Excel file owed to one member over WhatsApp (scheduled report, or an
// on-demand export the member asked the assistant for while their window was
// closed). The file itself is never stored: it is rebuilt from `filters` at
// send time.
model DataReportDelivery {
  id          String    @id @default(uuid()) @db.Uuid
  clinicId    String    @db.Uuid
  memberId    String    @db.Uuid
  // ExportFilters (lib/exports/filters.ts), with the resolved from/to days.
  filters     Json
  // Idempotency per member, e.g. "daily:2026-11-24".
  dedupeKey   String
  createdAt   DateTime  @default(now())
  // Official number, closed window: announced by the alert template; the file
  // follows when the member writes in.
  announcedAt DateTime?
  sentAt      DateTime?
  attempts    Int       @default(0)
  lastError   String?

  clinic Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  member ClinicMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, dedupeKey])
  @@index([sentAt, createdAt])
  @@index([clinicId])
  @@map("data_report_deliveries")
}

// ─── Operations (العمليات) ─────────────────────────────────────────────────────
// A surgery is a CASE the team runs over days or weeks, not a bookable slot: a
// patient can never book one. The patient AI only opens a REQUESTED case (and
// alerts the team); the team — from the dashboard or the team assistant —
// prepares it, schedules it, sends the patient the details and follows up.
// Design: docs/operations.md.

enum OperationStatus {
  REQUESTED // طلب جديد — opened from a patient's question; nobody has called yet
  PREPARING // قيد التجهيز — the team is on it: consultation, tests, price
  SCHEDULED // محددة — has a date and time
  DONE // تمت — performed; post-op follow-up phase
  CLOSED // مغلقة — follow-up finished
  CANCELLED // ملغاة
}

enum OperationSource {
  PATIENT_AI // the patient asked the AI assistant
  STAFF // the team created it (dashboard or team assistant)
}

model Operation {
  id                 String          @id @default(uuid()) @db.Uuid
  clinicId           String          @db.Uuid
  patientId          String          @db.Uuid
  // The operation type from the catalog (ServiceKind.OPERATION), if any. `name`
  // is the snapshot / free-text name shown everywhere.
  serviceId          String?         @db.Uuid
  name               String
  status             OperationStatus @default(REQUESTED)
  source             OperationSource @default(STAFF)
  // The surgeon. Null while the case is still a request.
  doctorId           String?         @db.Uuid
  // Where: one of the clinic's branches, or an outside hospital (free text).
  branchId           String?         @db.Uuid
  hospitalName       String?
  // When: clinic wall-clock, same convention as Appointment.bookingDate +
  // scheduledTime (see lib/slot-time.ts). Both set once SCHEDULED.
  scheduledDate      DateTime?       @db.Date
  startTime          String? // "HH:MM"
  durationMin        Int?
  // Block the surgeon's appointment slots during the operation (default on).
  blockSchedule      Boolean         @default(true)
  anesthesia         String? // نوع التخدير — free text (كلي، موضعي، نصفي…)
  // Agreed total. Payments are OperationPayment rows; remaining = price - paid.
  price              Decimal?        @db.Decimal(10, 2)
  consentSigned      Boolean         @default(false)
  // Texts sent to the patient — seeded from the service, editable per case.
  preOpInstructions  String?
  postOpInstructions String?
  // What the patient said when asking (PATIENT_AI), or the team's intake note.
  requestNote        String?
  // Internal notes — never shown or sent to the patient.
  notes              String?
  // The team member following this case.
  coordinatorId      String?         @db.Uuid
  // The conversation the request came from (PATIENT_AI).
  conversationId     String?         @db.Uuid
  cancelReason       String?
  doneAt             DateTime?
  // Automation dedupe flags (like Appointment.reminderSentAt).
  reminderSentAt     DateTime?
  followUpSentAt     DateTime?
  createdById        String?         @db.Uuid
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  clinic       Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient      Profile                  @relation("PatientOperations", fields: [patientId], references: [id], onDelete: Cascade)
  service      Service?                 @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  doctor       Doctor?                  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  branch       Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  coordinator  Profile?                 @relation("OperationCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  checklist    OperationChecklistItem[]
  payments     OperationPayment[]
  events       OperationEvent[]
  attachments  OperationAttachment[]
  blockedSlots Slot[]

  @@index([clinicId, status])
  @@index([clinicId, scheduledDate])
  @@index([patientId])
  @@index([doctorId, scheduledDate])
  @@index([branchId])
  @@index([serviceId])
  @@index([coordinatorId])
  // Automation sweeps: scheduled & not yet reminded; done & not yet followed up.
  @@index([status, reminderSentAt])
  @@index([status, followUpSentAt])
  @@map("operations")
}

// One pre-op checklist line (تحاليل، أشعة، إيقاف دواء، توقيع الإقرار…).
model OperationChecklistItem {
  id          String    @id @default(uuid()) @db.Uuid
  clinicId    String    @db.Uuid
  operationId String    @db.Uuid
  label       String
  sortOrder   Int       @default(0)
  doneAt      DateTime?
  doneById    String?   @db.Uuid
  createdAt   DateTime  @default(now())

  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId])
  @@index([clinicId])
  @@map("operation_checklist_items")
}

// Money received for an operation (deposit / installment). Decimal, never float.
model OperationPayment {
  id          String   @id @default(uuid()) @db.Uuid
  clinicId    String   @db.Uuid
  operationId String   @db.Uuid
  amount      Decimal  @db.Decimal(10, 2)
  method      String? // كاش، فيزا، تحويل…
  note        String?
  paidAt      DateTime @default(now())
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId])
  @@index([clinicId])
  @@map("operation_payments")
}

// The case history: who did what, when (status changes, scheduling, messages
// sent to the patient, payments…). Append-only.
model OperationEvent {
  id          String   @id @default(uuid()) @db.Uuid
  clinicId    String   @db.Uuid
  operationId String   @db.Uuid
  actorId     String?  @db.Uuid
  // Short machine tag: created, status, scheduled, updated, payment, message…
  type        String
  text        String
  createdAt   DateTime @default(now())

  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  actor     Profile?  @relation("OperationEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([operationId, createdAt])
  @@index([clinicId])
  @@index([actorId])
  @@map("operation_events")
}

// Files on the case (lab results, imaging, signed consent). Same private bucket
// as visit attachments, under `<clinicId>/operations/<operationId>/`.
model OperationAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  clinicId     String   @db.Uuid
  operationId  String   @db.Uuid
  uploadedById String   @db.Uuid
  storagePath  String
  fileName     String
  contentType  String
  size         Int
  kind         String
  createdAt    DateTime @default(now())

  clinic     Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  operation  Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  uploadedBy Profile   @relation("OperationAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([operationId])
  @@index([clinicId])
  @@index([uploadedById])
  @@map("operation_attachments")
}
