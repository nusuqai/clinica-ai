generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  schemas           = ["public", "auth"]
}

// ─── Enums ────────────────────────────────────────────────────────────────────

// Clinic-scoped roles. A user's role now lives on ClinicMember (per clinic), not
// on Profile — one account can be a PATIENT at one clinic and a DOCTOR at another.
enum Role {
  PATIENT
  DOCTOR
  ADMIN

  @@schema("public")
}

enum DayOfWeek {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT

  @@schema("public")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW

  @@schema("public")
}

enum Channel {
  WEB
  WHATSAPP

  @@schema("public")
}

enum SenderType {
  USER
  ADMIN
  AGENT

  @@schema("public")
}

enum ClinicRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("public")
}

// ─── Supabase Auth (externally managed) ──────────────────────────────────────

// Owned by Supabase GoTrue — NOT by Prisma. It exists here only so Prisma can
// resolve the profiles.id -> auth.users.id foreign key. Never let a generated
// migration ALTER or DROP anything in this schema: review every migration.sql
// before applying and delete any statement that touches `auth`.
model AuthUser {
  id                 String    @id @db.Uuid
  instanceId         String?   @map("instance_id") @db.Uuid
  aud                String?   @db.VarChar(255)
  role               String?   @db.VarChar(255)
  email              String?   @db.VarChar(255)
  encryptedPassword  String?   @map("encrypted_password") @db.VarChar(255)
  emailConfirmedAt   DateTime? @map("email_confirmed_at") @db.Timestamptz(6)
  invitedAt          DateTime? @map("invited_at") @db.Timestamptz(6)
  confirmationToken  String?   @map("confirmation_token") @db.VarChar(255)
  confirmationSentAt DateTime? @map("confirmation_sent_at") @db.Timestamptz(6)
  recoveryToken      String?   @map("recovery_token") @db.VarChar(255)
  recoverySentAt     DateTime? @map("recovery_sent_at") @db.Timestamptz(6)
  lastSignInAt       DateTime? @map("last_sign_in_at") @db.Timestamptz(6)
  rawAppMetaData     Json?     @map("raw_app_meta_data")
  rawUserMetaData    Json?     @map("raw_user_meta_data")
  isSuperAdmin       Boolean?  @map("is_super_admin")
  createdAt          DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime? @map("updated_at") @db.Timestamptz(6)
  phone              String?   @unique
  phoneConfirmedAt   DateTime? @map("phone_confirmed_at") @db.Timestamptz(6)
  bannedUntil        DateTime? @map("banned_until") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  isAnonymous        Boolean?  @map("is_anonymous")
  isSsoUser          Boolean?  @map("is_sso_user")

  profile Profile?

  @@map("users")
  @@schema("auth")
}

// ─── Tenancy ────────────────────────────────────────────────────────────────

// A tenant. Each clinic is isolated: its own members, doctors, appointments,
// conversations and branding. Reached at /clinic/{slug}.
model Clinic {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique
  name         String
  logoUrl      String?
  primaryColor String?
  accentColor  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members           ClinicMember[]
  doctors           Doctor[]
  appointments      Appointment[]
  conversations     Conversation[]
  requestsFulfilled ClinicRequest[] @relation("RequestCreatedClinic")

  @@map("clinics")
  @@schema("public")
}

// Membership join table: a Profile belongs to a Clinic with a role. The unique
// pair (userId, clinicId) means one role per user per clinic.
model ClinicMember {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  clinicId  String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())

  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId])
  @@index([clinicId])
  @@map("clinic_members")
  @@schema("public")
}

// A request (from the public landing page) to create a new clinic. The platform
// admin team reviews and approves/rejects it; on approval a Clinic is created and
// the requester is set up as that clinic's ADMIN.
model ClinicRequest {
  id                  String              @id @default(uuid()) @db.Uuid
  requesterName       String
  requesterEmail      String
  requesterPhone      String?
  requestedClinicName String
  requestedSlug       String?
  note                String?
  status              ClinicRequestStatus @default(PENDING)
  reviewedById        String?             @db.Uuid
  reviewedAt          DateTime?
  createdClinicId     String?             @db.Uuid
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  reviewedBy    Profile? @relation("RequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdClinic Clinic?  @relation("RequestCreatedClinic", fields: [createdClinicId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("clinic_requests")
  @@schema("public")
}

// ─── Models ───────────────────────────────────────────────────────────────────

// Mirrors auth.users — id is provided by Supabase Auth, not generated by Prisma.
// Identity only: the per-clinic role lives on ClinicMember. isPlatformAdmin marks
// the Nusuq administration team that manages all clinics.
model Profile {
  id              String   @id @db.Uuid
  fullName        String
  phone           String?  @unique
  avatarUrl       String?
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  authUser          AuthUser        @relation(fields: [id], references: [id], onDelete: Cascade)
  doctor            Doctor?
  appointments      Appointment[]
  conversations     Conversation[]
  sentMessages      Message[]       @relation("SenderProfile")
  clinicMemberships ClinicMember[]
  reviewedRequests  ClinicRequest[] @relation("RequestReviewer")

  @@map("profiles")
  @@schema("public")
}

// A doctor is a standalone record scoped to a clinic. It can exist WITHOUT any
// login account (profileId null) and still be linked to appointments; an account
// can be linked later by setting profileId.
model Doctor {
  id              String   @id @default(uuid()) @db.Uuid
  clinicId        String   @db.Uuid
  profileId       String?  @unique @db.Uuid
  fullName        String
  phone           String?
  specialty       String
  bio             String?
  consultationFee Decimal? @db.Decimal(10, 2)
  isActive        Boolean  @default(true)

  clinic            Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  profile           Profile?           @relation(fields: [profileId], references: [id], onDelete: SetNull)
  availabilityRules AvailabilityRule[]
  slots             Slot[]
  appointments      Appointment[]

  @@index([clinicId])
  @@map("doctors")
  @@schema("public")
}

model AvailabilityRule {
  id              String    @id @default(uuid()) @db.Uuid
  doctorId        String    @db.Uuid
  dayOfWeek       DayOfWeek
  startTime       String // "HH:MM" e.g. "14:00"
  endTime         String // "HH:MM" e.g. "17:00"
  slotDurationMin Int       @default(30)
  isActive        Boolean   @default(true)
  generatedUntil  DateTime? @db.Date // tracks how far ahead slots have been generated

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  slots  Slot[]

  @@index([doctorId])
  @@map("availability_rules")
  @@schema("public")
}

model Slot {
  id        String   @id @default(uuid()) @db.Uuid
  doctorId  String   @db.Uuid
  ruleId    String?  @db.Uuid
  date      DateTime @db.Date
  startTime DateTime
  endTime   DateTime
  isBlocked Boolean  @default(false)

  doctor      Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  rule        AvailabilityRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  appointment Appointment?

  @@index([doctorId, date])
  @@map("slots")
  @@schema("public")
}

model Appointment {
  id                 String            @id @default(uuid()) @db.Uuid
  clinicId           String            @db.Uuid
  patientId          String            @db.Uuid
  doctorId           String            @db.Uuid
  slotId             String            @unique @db.Uuid
  status             AppointmentStatus @default(PENDING)
  patientNotes       String?
  doctorNotes        String?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Profile @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])
  slot    Slot    @relation(fields: [slotId], references: [id])

  @@index([clinicId])
  @@index([patientId])
  @@index([doctorId])
  @@map("appointments")
  @@schema("public")
}

model Conversation {
  id            String   @id @default(uuid()) @db.Uuid
  clinicId      String   @db.Uuid
  userId        String?  @db.Uuid
  whatsappPhone String?
  whatsappName  String?
  channel       Channel
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic      Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user        Profile?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
  sessions    ChatSession[]
  escalations Escalation[]

  @@unique([clinicId, whatsappPhone])
  @@unique([clinicId, userId, channel])
  @@index([clinicId])
  @@map("conversations")
  @@schema("public")
}

// A bounded chat window (fixed 30-min from its first message) used to scope
// LLM context and to group messages with dividers in the admin inbox.
model ChatSession {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  startedAt      DateTime @default(now())
  expiresAt      DateTime // startedAt + 30 min
  // AI auto-reply for this session. Defaults on for every new session; the
  // admin can pause it, or the escalate_to_human tool turns it off when the
  // user asks for a human. Does not carry over to the next session.
  aiEnabled      Boolean  @default(true)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messages     Message[]
  escalations  Escalation[]

  @@index([conversationId])
  @@map("chat_sessions")
  @@schema("public")
}

// One row per escalate_to_human request. A session can have several — e.g.
// user escalates, admin re-enables the AI, user escalates again.
model Escalation {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  sessionId      String    @db.Uuid
  reason         String?
  createdAt      DateTime  @default(now())
  // Set when an admin re-enables the AI for the session or sends a manual
  // reply in the conversation — whichever happens first. Null = still open.
  resolvedAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  session      ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([sessionId])
  @@map("escalations")
  @@schema("public")
}

model Message {
  id             String     @id @default(uuid()) @db.Uuid
  conversationId String     @db.Uuid
  sessionId      String?    @db.Uuid
  senderType     SenderType
  senderId       String?    @db.Uuid // null when senderType = AGENT
  content        String
  metadata       Json? // { toolCalls: [{ name, args, result, status }] } — set on AGENT messages that ran tools
  isRead         Boolean    @default(false)
  createdAt      DateTime   @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  session      ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sender       Profile?     @relation("SenderProfile", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([sessionId])
  @@map("messages")
  @@schema("public")
}
