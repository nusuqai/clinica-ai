generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

// Clinic-scoped roles. A user's role now lives on ClinicMember (per clinic), not
// on Profile — one account can be a PATIENT at one clinic and a DOCTOR at another.
enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum DayOfWeek {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum Channel {
  WEB
  WHATSAPP
}

enum SenderType {
  USER
  ADMIN
  AGENT
}

enum ClinicRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Money-movement kinds on the per-clinic AI credit ledger. TOPUP/ADJUSTMENT are
// platform-admin actions; USAGE is written automatically when the agent replies.
enum AiLedgerType {
  TOPUP
  USAGE
  ADJUSTMENT
}

// Phone-number kinds shown on clinic/branch contact info.
// LANDLINE = التليفون الأرضي, MOBILE = الخط العادي/موبايل.
enum PhoneType {
  LANDLINE
  MOBILE
  WHATSAPP
}

// Doctor's professional rank shown on their profile.
// SPECIALIST = أخصائي, CONSULTANT = استشاري.
enum DoctorTitle {
  SPECIALIST
  CONSULTANT
}

// Social-media platforms for a clinic's public accounts.
enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  X
  TIKTOK
  YOUTUBE
  WEBSITE
  OTHER
}

// ─── Tenancy ────────────────────────────────────────────────────────────────

// A tenant. Each clinic is isolated: its own members, doctors, appointments,
// conversations and branding. Reached at /clinic/{slug}.
model Clinic {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique
  name         String
  description  String?
  logoUrl      String?
  primaryColor String?
  accentColor  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members           ClinicMember[]
  branches          Branch[]
  phones            ClinicPhone[]
  socials           ClinicSocial[]
  specialties       Specialty[]
  doctors           Doctor[]
  appointments      Appointment[]
  conversations     Conversation[]
  requestsFulfilled ClinicRequest[]  @relation("RequestCreatedClinic")
  whatsappConfig    WhatsappConfig?
  aiCredit          ClinicAiCredit?
  aiUsage           AiUsageLog[]
  aiLedger          AiCreditLedger[]

  @@map("clinics")
}

// ─── Branches & contact info ──────────────────────────────────────────────────

// A physical location of a clinic. Every clinic has at least one branch
// (isMain). Doctors work at one or more branches (DoctorBranch), and each
// availability rule / slot / appointment carries the branch it belongs to.
model Branch {
  id              String   @id @default(uuid()) @db.Uuid
  clinicId        String   @db.Uuid
  name            String
  isMain          Boolean  @default(false)
  isActive        Boolean  @default(true)
  address         String?
  mapsUrl         String? // google maps link
  latitude        Decimal? @db.Decimal(10, 7)
  longitude       Decimal? @db.Decimal(10, 7)
  hasParking      Boolean  @default(false)
  parkingInfo     String?
  nearestLandmark String? // أقرب معلم
  directions      String? // كيفية الوصول
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic            Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  phones            BranchPhone[]
  hours             BranchHours[]
  doctors           DoctorBranch[]
  availabilityRules AvailabilityRule[]
  slots             Slot[]
  appointments      Appointment[]

  @@index([clinicId])
  @@map("branches")
}

// Phone specific to one branch.
model BranchPhone {
  id        String    @id @default(uuid()) @db.Uuid
  branchId  String    @db.Uuid
  type      PhoneType
  number    String
  label     String? // e.g. "استقبال", "حجز"
  isPrimary Boolean   @default(false)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@map("branch_phones")
}

// Branch opening hours — one row per weekday. A day off is isClosed = true
// (openTime/closeTime null). Doctor availability rules must fit inside the
// branch's [openTime, closeTime] for that day.
model BranchHours {
  id        String    @id @default(uuid()) @db.Uuid
  branchId  String    @db.Uuid
  dayOfWeek DayOfWeek
  isClosed  Boolean   @default(false)
  openTime  String? // "HH:MM"
  closeTime String? // "HH:MM"

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
  @@map("branch_hours")
}

// General clinic-level phone. The clinic's main number is the row with
// isPrimary = true.
model ClinicPhone {
  id        String    @id @default(uuid()) @db.Uuid
  clinicId  String    @db.Uuid
  type      PhoneType
  number    String
  label     String?
  isPrimary Boolean   @default(false)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@map("clinic_phones")
}

// A clinic's public social-media account. Clinic-level (not per-branch).
model ClinicSocial {
  id       String         @id @default(uuid()) @db.Uuid
  clinicId String         @db.Uuid
  platform SocialPlatform
  url      String

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@map("clinic_socials")
}

// Per-clinic WhatsApp Cloud API (Meta official) credentials. Entered manually
// by an admin — no embedded-signup provider yet (business not verified), and
// each clinic runs its OWN Meta app, so we can't collect app secrets to verify
// webhook signatures. Instead each clinic gets a unique, unguessable webhook
// URL: the `webhookToken` in the path both identifies the clinic and acts as
// the shared secret. The access token is encrypted at rest (AES-256-GCM, see
// lib/crypto/secret-box.ts); the other values are low-sensitivity config the
// clinic itself must copy into Meta.
model WhatsappConfig {
  id                String   @id @default(uuid()) @db.Uuid
  clinicId          String   @unique @db.Uuid
  // WhatsApp sender id ("Phone number ID" in the Meta dashboard).
  phoneNumberId     String   @unique
  // WhatsApp Business Account id — needed to list/create message templates.
  wabaId            String
  // System-user access token, encrypted. Never selected into client code raw.
  accessTokenCipher String
  // Unguessable token embedded in this clinic's unique callback URL
  // (…/api/meta/whatsapp/webhook/{webhookToken}). Routes inbound events to the
  // clinic and, in lieu of app-secret signature verification, gates the
  // endpoint. Rotatable independently of the clinic's identity.
  webhookToken      String   @unique
  // The verify token this clinic types into Meta's webhook config; checked on
  // the GET verification handshake.
  verifyToken       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("whatsapp_configs")
}

// Membership join table: a Profile belongs to a Clinic with a role. The unique
// pair (userId, clinicId) means one role per user per clinic.
model ClinicMember {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  clinicId  String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())

  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId])
  @@index([clinicId])
  @@map("clinic_members")
}

// A request (from the public landing page) to create a new clinic. The platform
// admin team reviews and approves/rejects it; on approval a Clinic is created and
// the requester is set up as that clinic's ADMIN.
model ClinicRequest {
  id                  String              @id @default(uuid()) @db.Uuid
  requesterName       String
  requesterEmail      String
  requesterPhone      String?
  requestedClinicName String
  requestedSlug       String?
  note                String?
  status              ClinicRequestStatus @default(PENDING)
  reviewedById        String?             @db.Uuid
  reviewedAt          DateTime?
  createdClinicId     String?             @db.Uuid
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  reviewedBy    Profile? @relation("RequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdClinic Clinic?  @relation("RequestCreatedClinic", fields: [createdClinicId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("clinic_requests")
}

// ─── Models ───────────────────────────────────────────────────────────────────

// Mirrors auth.users — id is provided by Supabase Auth, not generated by Prisma.
// Identity only: the per-clinic role lives on ClinicMember. isPlatformAdmin marks
// the Nusuq administration team that manages all clinics.
model Profile {
  id              String   @id @db.Uuid
  fullName        String
  phone           String?  @unique
  avatarUrl       String?
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  doctor            Doctor?
  appointments      Appointment[]
  conversations     Conversation[]
  sentMessages      Message[]       @relation("SenderProfile")
  clinicMemberships ClinicMember[]
  reviewedRequests  ClinicRequest[] @relation("RequestReviewer")

  @@map("profiles")
}

// A doctor is a standalone record scoped to a clinic. It can exist WITHOUT any
// login account (profileId null) and still be linked to appointments; an account
// can be linked later by setting profileId.
model Doctor {
  id                     String   @id @default(uuid()) @db.Uuid
  clinicId               String   @db.Uuid
  profileId              String?  @unique @db.Uuid
  specialtyId            String?  @db.Uuid // FK to the clinic's Specialty list
  fullName               String
  phone                  String?
  title                  DoctorTitle? // أخصائي / استشاري
  qualifications         String? // المؤهلات العلمية
  expertiseAreas         String? // مجالات الخبرة الدقيقة
  bio                    String?
  yearsOfExperience      Int?
  examinationFee         Decimal? @db.Decimal(10, 2) // سعر الكشف
  consultationFee        Decimal? @db.Decimal(10, 2) // سعر الاستشارة
  requiresAdvanceBooking Boolean  @default(true) // يحتاج حجزاً مسبقاً؟
  acceptsChildren        Boolean  @default(false) // يكشف على الأطفال؟
  isActive               Boolean  @default(true)

  clinic            Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  profile           Profile?           @relation(fields: [profileId], references: [id], onDelete: SetNull)
  specialty         Specialty?         @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  branches          DoctorBranch[]
  availabilityRules AvailabilityRule[]
  slots             Slot[]
  appointments      Appointment[]

  @@index([clinicId])
  @@index([specialtyId])
  @@map("doctors")
}

// Per-clinic list of medical specialties. Names are unique within a clinic;
// the same name can exist across different clinics. Case-insensitive
// uniqueness is enforced at the service layer.
model Specialty {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic  Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctors Doctor[]

  @@unique([clinicId, name])
  @@index([clinicId])
  @@map("specialties")
}

// Join table: which branches a doctor works at (many-to-many).
model DoctorBranch {
  doctorId String @db.Uuid
  branchId String @db.Uuid

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([doctorId, branchId])
  @@index([branchId])
  @@map("doctor_branches")
}

model AvailabilityRule {
  id              String    @id @default(uuid()) @db.Uuid
  doctorId        String    @db.Uuid
  branchId        String?   @db.Uuid // branch this schedule is for (required for new rows)
  dayOfWeek       DayOfWeek
  startTime       String // "HH:MM" e.g. "14:00"
  endTime         String // "HH:MM" e.g. "17:00"
  slotDurationMin Int       @default(30)
  isActive        Boolean   @default(true)
  generatedUntil  DateTime? @db.Date // tracks how far ahead slots have been generated

  doctor Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  slots  Slot[]

  @@index([doctorId])
  @@index([branchId])
  @@map("availability_rules")
}

model Slot {
  id        String   @id @default(uuid()) @db.Uuid
  doctorId  String   @db.Uuid
  branchId  String?  @db.Uuid // copied from the rule at generation time
  ruleId    String?  @db.Uuid
  date      DateTime @db.Date
  startTime DateTime
  endTime   DateTime
  isBlocked Boolean  @default(false)

  doctor      Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch      Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  rule        AvailabilityRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  appointment Appointment?

  @@index([doctorId, date])
  @@index([branchId])
  @@map("slots")
}

model Appointment {
  id                 String            @id @default(uuid()) @db.Uuid
  clinicId           String            @db.Uuid
  branchId           String?           @db.Uuid // copied from the slot at booking time
  patientId          String            @db.Uuid
  doctorId           String            @db.Uuid
  slotId             String            @unique @db.Uuid
  status             AppointmentStatus @default(PENDING)
  patientNotes       String?
  doctorNotes        String?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient Profile @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])
  slot    Slot    @relation(fields: [slotId], references: [id])

  @@index([clinicId])
  @@index([branchId])
  @@index([patientId])
  @@index([doctorId])
  @@map("appointments")
}

model Conversation {
  id            String   @id @default(uuid()) @db.Uuid
  clinicId      String   @db.Uuid
  userId        String?  @db.Uuid
  whatsappPhone String?
  whatsappName  String?
  channel       Channel
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic      Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user        Profile?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
  sessions    ChatSession[]
  escalations Escalation[]

  @@unique([clinicId, whatsappPhone])
  @@unique([clinicId, userId, channel])
  @@index([clinicId])
  @@map("conversations")
}

// A bounded chat window (fixed 30-min from its first message) used to scope
// LLM context and to group messages with dividers in the admin inbox.
model ChatSession {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  startedAt      DateTime @default(now())
  expiresAt      DateTime // startedAt + SESSION_MINUTES (env, default 30 min)
  // AI auto-reply for this session. Defaults on for every new session; the
  // admin can pause it, or the escalate_to_human tool turns it off when the
  // user asks for a human. Does not carry over to the next session.
  aiEnabled      Boolean  @default(true)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messages     Message[]
  escalations  Escalation[]
  aiUsage      AiUsageLog[]

  @@index([conversationId])
  @@map("chat_sessions")
}

// One row per escalate_to_human request. A session can have several — e.g.
// user escalates, admin re-enables the AI, user escalates again.
model Escalation {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  sessionId      String    @db.Uuid
  reason         String?
  createdAt      DateTime  @default(now())
  // Set when an admin re-enables the AI for the session or sends a manual
  // reply in the conversation — whichever happens first. Null = still open.
  resolvedAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  session      ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([sessionId])
  @@map("escalations")
}

model Message {
  id             String     @id @default(uuid()) @db.Uuid
  conversationId String     @db.Uuid
  sessionId      String?    @db.Uuid
  senderType     SenderType
  senderId       String?    @db.Uuid // null when senderType = AGENT
  content        String
  metadata       Json? // { toolCalls: [{ name, args, result, status }] } — set on AGENT messages that ran tools
  isRead         Boolean    @default(false)
  createdAt      DateTime   @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  session      ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sender       Profile?     @relation("SenderProfile", fields: [senderId], references: [id], onDelete: SetNull)
  aiUsage      AiUsageLog?

  @@index([conversationId])
  @@index([sessionId])
  @@map("messages")
}

// ─── AI credit & cost metering ────────────────────────────────────────────────

// 1:1 satellite of Clinic (mirrors WhatsappConfig). Holds the per-clinic global
// AI on/off switch (clinic-admin controlled) and the prepaid USD credit state.
// `balance` is a denormalized cache — the AiCreditLedger is the source of truth
// (SUM(amount) must equal balance). `markup` is the per-clinic multiplier applied
// to the raw OpenAI cost (platform-admin controlled). All money is Decimal(18,8):
// a single agent turn can cost far under one cent, so 8 fractional digits keep
// sums of many tiny charges exact. Never touched by JS floats.
model ClinicAiCredit {
  id                  String   @id @default(uuid()) @db.Uuid
  clinicId            String   @unique @db.Uuid
  // Per-clinic global AI auto-reply switch. Distinct from ChatSession.aiEnabled
  // (a per-session pause) — this turns the agent off across the whole clinic.
  aiEnabled           Boolean  @default(true)
  balance             Decimal  @default(0) @db.Decimal(18, 8)
  markup              Decimal  @default(1.5) @db.Decimal(6, 4)
  lowBalanceThreshold Decimal  @default(5) @db.Decimal(18, 8)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("clinic_ai_credits")
}

// Append-only usage/cost analytics — one row per charged agent reply. Stores the
// token counts, the rate + markup snapshots (so historical cost stays correct if
// pricing changes later) and both the raw OpenAI cost and the charged (marked-up)
// cost actually deducted. `messageId` is unique: a webhook redelivery that
// re-charges the same reply hits the constraint and rolls the whole txn back.
model AiUsageLog {
  id               String   @id @default(uuid()) @db.Uuid
  clinicId         String   @db.Uuid
  sessionId        String?  @db.Uuid
  messageId        String?  @unique @db.Uuid
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  inputRatePerM    Decimal  @db.Decimal(12, 4)
  outputRatePerM   Decimal  @db.Decimal(12, 4)
  rawCost          Decimal  @db.Decimal(18, 8)
  markup           Decimal  @db.Decimal(6, 4)
  chargedCost      Decimal  @db.Decimal(18, 8)
  createdAt        DateTime @default(now())

  clinic  Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  session ChatSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  message Message?        @relation(fields: [messageId], references: [id], onDelete: SetNull)
  ledger  AiCreditLedger?

  @@index([clinicId, createdAt])
  @@map("ai_usage_logs")
}

// Append-only money ledger — the SOURCE OF TRUTH for ClinicAiCredit.balance.
// `amount` is signed (+topup, -usage, ± adjustment); `balanceAfter` snapshots the
// running balance right after this entry. USAGE rows link 1:1 to their AiUsageLog.
model AiCreditLedger {
  id           String       @id @default(uuid()) @db.Uuid
  clinicId     String       @db.Uuid
  type         AiLedgerType
  amount       Decimal      @db.Decimal(18, 8)
  balanceAfter Decimal      @db.Decimal(18, 8)
  usageId      String?      @unique @db.Uuid
  note         String?
  actorId      String?      @db.Uuid
  createdAt    DateTime     @default(now())

  clinic Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  usage  AiUsageLog? @relation(fields: [usageId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
  @@map("ai_credit_ledger")
}
